<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options" 
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:core="clr-namespace:Ju.GundamWars;assembly=Ju.GundamWars.Core"
	>

    <!-- #region Generic -->

    <DataTemplate x:Key="GwComboBoxGroupHeaderTemplate">
        <TextBlock Padding="8 4" Text="{Binding Name}" Foreground="{DynamicResource PrimaryHueMidBrush}" />
    </DataTemplate>

    <Style x:Key="GwComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource MaterialDesignComboBox}">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Height" Value="30" />
        <Setter Property="IsSynchronizedWithCurrentItem" Value="False" />
        <Setter Property="materialDesign:ValidationAssist.Background" Value="Transparent" />
    </Style>

    <!-- #endregion -->

    <!-- #region Filter -->

	<Style x:Key="GwFilterComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource GwComboBox}">
		<Setter Property="Margin" Value="8" />
		<Setter Property="materialDesign:TextFieldAssist.HasClearButton" Value="True" />
	</Style>

	<!-- Common -->

    <Style x:Key="GwFilterBoostStatusComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource GwFilterComboBox}" x:Shared="False">
        <Setter Property="Width" Value="144" />
        <Setter Property="DisplayMemberPath" Value="Name" />
        <Setter Property="ItemsSource" Value="{Binding BoostStatuses}" />
        <Setter Property="SelectedItem" Value="{Binding BoostStatusFilter}" />
        <!-- TODO: <Setter Property="materialDesign:HintAssist.Hint" Value="{Binding Source={x:Static core:GwText.BoostStatus}}" />-->
    </Style>

    <Style x:Key="GwFilterForUnitComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource GwFilterComboBox}" x:Shared="False">
        <Setter Property="Width" Value="88" />
        <Setter Property="ItemsSource" Value="{Binding ForUnits}" />
        <Setter Property="SelectedItem" Value="{Binding ForUnitFilter}" />
        <!-- TODO: <Setter Property="materialDesign:HintAssist.Hint" Value="{Binding Source={x:Static core:GwText.ForUnit}}" />-->
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" >
                        <materialDesign:PackIcon Margin="0 0 8 0" VerticalAlignment="Center" Kind="{Binding Icon}" x:Shared="False" />
                        <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GwFilterRoleComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource GwFilterComboBox}">
        <Setter Property="Width" Value="80" />
        <Setter Property="DisplayMemberPath" Value="Name" />
        <Setter Property="ItemsSource" Value="{Binding Roles}" />
        <Setter Property="SelectedItem" Value="{Binding RoleFilter}" />
        <Setter Property="materialDesign:HintAssist.Hint" Value="{Binding Source={x:Static core:GwText.Role}}" />
    </Style>

    <Style x:Key="GwFilterSerialComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource GwFilterComboBox}" x:Shared="False">
        <Setter Property="Width" Value="300" />
        <Setter Property="DisplayMemberPath" Value="Name" />
        <Setter Property="ItemsSource" Value="{Binding Serials}" />
        <Setter Property="SelectedItem" Value="{Binding SerialFilter}" />
        <Setter Property="materialDesign:HintAssist.Hint" Value="{Binding Source={x:Static core:GwText.Serial}}" />
    </Style>

    <Style x:Key="GwFilterTagComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource GwFilterComboBox}" x:Shared="False">
        <Setter Property="Width" Value="144" />
        <Setter Property="DisplayMemberPath" Value="Name" />
        <Setter Property="ItemsSource" Value="{Binding Tags}" />
        <Setter Property="SelectedItem" Value="{Binding TagFilter}" />
        <Setter Property="materialDesign:HintAssist.Hint" Value="{Binding Source={x:Static core:GwText.Tag}}" />
    </Style>

    <!-- CoMobiles -->

    <!-- Cuspas -->

    <Style x:Key="GwFilterCuspaKindComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource GwFilterComboBox}" x:Shared="False">
        <Setter Property="Width" Value="96" />
        <Setter Property="DisplayMemberPath" Value="Name" />
        <Setter Property="ItemsSource" Value="{Binding CuspaKinds}" />
        <Setter Property="SelectedItem" Value="{Binding CuspaKindFilter}" />
        <!-- TODO: <Setter Property="materialDesign:HintAssist.Hint" Value="{Binding Source={x:Static core:GwText.CuspaKind}}" />-->
    </Style>

    <!-- Mobiles -->

    <!-- Pilots -->

    <Style x:Key="GwFilterPilotAbilityComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource GwFilterComboBox}" x:Shared="False">
        <Setter Property="Width" Value="224" />
        <Setter Property="DisplayMemberPath" Value="Name" />
        <Setter Property="ItemsSource" Value="{Binding PilotAbilities}" />
        <Setter Property="SelectedItem" Value="{Binding PilotAbilityFilter}" />
        <Setter Property="materialDesign:HintAssist.Hint" Value="アビリティ" />
    </Style>

    <Style x:Key="GwFilterPilotSkillComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource GwFilterComboBox}" x:Shared="False">
        <Setter Property="Width" Value="224" />
        <Setter Property="DisplayMemberPath" Value="Name" />
        <Setter Property="ItemsSource" Value="{Binding PilotSkills}" />
        <Setter Property="SelectedItem" Value="{Binding PilotSkillFilter}" />
        <Setter Property="materialDesign:HintAssist.Hint" Value="スキル" />
    </Style>

    <!-- Supports -->

    <Style x:Key="GwFilterSupportBadgeComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource GwFilterComboBox}" x:Shared="False">
        <Setter Property="Width" Value="220" />
        <Setter Property="DisplayMemberPath" Value="Name" />
        <Setter Property="ItemsSource" Value="{Binding SupportBadges}" />
        <Setter Property="SelectedItem" Value="{Binding SupportBadgeFilter}" />
        <Setter Property="materialDesign:HintAssist.Hint" Value="バッジ" />
    </Style>

    <Style x:Key="GwFilterSupportSlotComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource GwFilterComboBox}" x:Shared="False">
        <Setter Property="Width" Value="224" />
        <Setter Property="DisplayMemberPath" Value="Name" />
        <Setter Property="ItemsSource" Value="{Binding SupportSlots}" />
        <Setter Property="SelectedItem" Value="{Binding SupportSlotFilter}" />
        <Setter Property="materialDesign:HintAssist.Hint" Value="スロット" />
    </Style>

    <!-- TODO:
    <Style x:Key="GwFilterUnlockSlotComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource GwFilterComboBox}" x:Shared="False">
        <Setter Property="Width" Value="224" />
        <Setter Property="DisplayMemberPath" Value="Name" />
        <Setter Property="ItemsSource" Value="{Binding UnlockSlots}" />
        <Setter Property="SelectedItem" Value="{Binding UnlockSlotFilter}" />
        <Setter Property="materialDesign:HintAssist.Hint" Value="Unlock Slot" />
    </Style>
    -->
    <!-- TODO:
    <Style x:Key="GwFilterBonusSlotComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource GwFilterComboBox}" x:Shared="False">
        <Setter Property="Width" Value="224" />
        <Setter Property="DisplayMemberPath" Value="Name" />
        <Setter Property="ItemsSource" Value="{Binding BonusSlots}" />
        <Setter Property="SelectedItem" Value="{Binding BonusSlotFilter}" />
        <Setter Property="materialDesign:HintAssist.Hint" Value="Bonus Slot" />
    </Style>
    -->

    <!-- Tags -->

    <!-- #endregion -->

    <!-- #region Entry -->

    <Style x:Key="GwEntryComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource GwComboBox}">
        <Setter Property="Margin" Value="8 0 8 8" />
        <Setter Property="Width" Value="448" />
        <Setter Property="Height" Value="32" />
        <Setter Property="materialDesign:HintAssist.Hint" Value="Select..." />
    </Style>

    <!-- Common -->

    <Style x:Key="GwEntrySerialComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource GwEntryComboBox}" x:Shared="False">
        <Setter Property="DisplayMemberPath" Value="Name" />
        <Setter Property="ItemsSource" Value="{Binding Serials}" />
        <Setter Property="SelectedItem" Value="{Binding Model.Serial}" />
    </Style>

