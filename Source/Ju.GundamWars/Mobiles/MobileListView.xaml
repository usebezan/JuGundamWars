<UserControl x:Class="Ju.GundamWars.Mobiles.MobileListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ctrl="clr-namespace:Ju.GundamWars.Controls"
    xmlns:local="clr-namespace:Ju.GundamWars.Mobiles"
    xmlns:const="clr-namespace:Ju.GundamWars.Const;assembly=Ju.GundamWars.Core"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance local:MobileListViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    SnapsToDevicePixels="True"
    >
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <ctrl:AddMenuUserControl />
                <Separator Margin="4" />
                <Button Command="{Binding ChechAllCommand}" Content="{materialDesign:PackIcon CheckboxMultipleMarked}" ToolTip="Chech all filtered" />
                <Button Command="{Binding UnchechAllCommand}" Content="{materialDesign:PackIcon CheckboxMultipleBlankOutline}" ToolTip="Unchech all filtered" />
                <Button Command="{Binding ClearCommand}" Content="{materialDesign:PackIcon FilterRemoveOutline}" ToolTip="Clear filter" />
                <ToggleButton Style="{StaticResource GwFilterCheckedToggleButton}" />
                <TextBox Style="{StaticResource GwFilterWordTextBox}" />
                <ComboBox Style="{StaticResource GwFilterCategoryComboBox}" />
                <ComboBox Style="{StaticResource GwFilterTagComboBox}" />
                <ToggleButton Style="{StaticResource GwFilterPinnedToggleButton}" />
                <ToggleButton Style="{StaticResource GwFilterHasMemoToggleButton}" />
                <ComboBox Style="{StaticResource GwFilterSerialComboBox}" />
            </ToolBar>
        </ToolBarTray>
        <DataGrid FrozenColumnCount="2" RowHeight="NaN">
            <DataGrid.Columns>
                <DataGridTemplateColumn>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Content="{Binding Id}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Name"
                    CellTemplate="{StaticResource GwListNameCellTemplate}"
                    SortMemberPath="Name"
                    SortDirection="Ascending"
                />

                <DataGridTemplateColumn Header="Pair"
                    SortMemberPath="Pair.Name"
                    Width="120"
                    >
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ContentControl Content="{Binding Pair}" ContentTemplate="{StaticResource GwListNameTemplate2}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="{Binding Source={x:Static const:GwText.Hp}}"
                    ElementStyle="{StaticResource GwListRightTextColumn}"
                    Binding="{Binding ActualStatus.Hp, StringFormat={}{0:N0}}"
                />
                <DataGridTextColumn Header="{Binding Source={x:Static const:GwText.BeamAttack}}"
                    ElementStyle="{StaticResource GwListRightTextColumn}"
                    Binding="{Binding ActualStatus.BeamAttack, StringFormat={}{0:N0}}"
                />
                <DataGridTextColumn Header="{Binding Source={x:Static const:GwText.PhysicalAttack}}"
                    ElementStyle="{StaticResource GwListRightTextColumn}"
                    Binding="{Binding ActualStatus.PhysicalAttack, StringFormat={}{0:N0}}"
                />
                <DataGridTextColumn Header="{Binding Source={x:Static const:GwText.BeamDefence}}"
                    ElementStyle="{StaticResource GwListRightTextColumn}"
                    Binding="{Binding ActualStatus.BeamDefence, StringFormat={}{0:N0}}"
                />
                <DataGridTextColumn Header="{Binding Source={x:Static const:GwText.PhysicalDefence}}"
                    ElementStyle="{StaticResource GwListRightTextColumn}"
                    Binding="{Binding ActualStatus.PhysicalDefence, StringFormat={}{0:N0}}"
                />
                <!--<DataGridTextColumn Header="{Binding Source={x:Static const:GwText.CriticalRate}}"
                    ElementStyle="{StaticResource GwListRightTextColumn}"
                    Binding="{Binding ActualStatus.CriticalRate, StringFormat={}{0:N0}%}"
                />-->
                <DataGridTextColumn Header="{Binding Source={x:Static const:GwText.CriticalDamage}}"
                    ElementStyle="{StaticResource GwListRightTextColumn}"
                    Binding="{Binding ActualStatus.CriticalDamage, StringFormat={}{0:N0}}"
                />
                <DataGridTextColumn Header="{Binding Source={x:Static const:GwText.Accuracy}}"
                    ElementStyle="{StaticResource GwListRightTextColumn}"
                    Binding="{Binding ActualStatus.Accuracy, StringFormat={}{0:N0}}"
                />
                <DataGridTextColumn Header="{Binding Source={x:Static const:GwText.Evasion}}"
                    ElementStyle="{StaticResource GwListRightTextColumn}"
                    Binding="{Binding ActualStatus.Evasion, StringFormat={}{0:N0}}"
                />
                <DataGridTextColumn Header="{Binding Source={x:Static const:GwText.Mobility}}"
                    ElementStyle="{StaticResource GwListRightTextColumn}"
                    Binding="{Binding ActualStatus.Mobility, StringFormat={}{0:N0}}"
                />
                <DataGridTextColumn Header="{Binding Source={x:Static const:GwText.SuperEnRecovery}}"
                    ElementStyle="{StaticResource GwListRightTextColumn}"
                    Binding="{Binding ActualStatus.SuperEnRecovery, StringFormat={}{0:N0}}"
                />
                <DataGridTextColumn Header="{Binding Source={x:Static const:GwText.AceEnRecovery}}"
                    ElementStyle="{StaticResource GwListRightTextColumn}"
                    Binding="{Binding ActualStatus.AceEnRecovery, StringFormat={}{0:N0}}"
                />
                <DataGridTextColumn Header="{Binding Source={x:Static const:GwText.SuperPower}}"
                    ElementStyle="{StaticResource GwListRightTextColumn}"
                    Binding="{Binding ActualStatus.SuperPower, StringFormat={}{0:N0}%}"
                />
                <DataGridTextColumn Header="{Binding Source={x:Static const:GwText.AcePower}}"
                    ElementStyle="{StaticResource GwListRightTextColumn}"
                    Binding="{Binding ActualStatus.AcePower, StringFormat={}{0:N0}%}"
                />
                <DataGridTextColumn Header="{Binding Source={x:Static const:GwText.RecoveryPower}}"
                    ElementStyle="{StaticResource GwListRightTextColumn}"
                    Binding="{Binding ActualStatus.RecoveryPower, StringFormat={}{0:N0}%}"
                />

                <DataGridTemplateColumn Header="Pilot"
                    SortMemberPath="Pilot.Name"
                    >
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center">
                                <Hyperlink Command="{Binding DataContext.OpenPilotAsEditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding Pilot}">
                                    <TextBlock Text="{Binding Pilot.Name}" />
                                </Hyperlink>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Support"
                    SortMemberPath="Grade.Value"
                    >
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                            <Setter Property="ToolTip" Value="Unlock2 > Code: 1&#10;Unlock3 > Code: 2&#10;Unlock4 > Code: 3"/>
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel VerticalAlignment="Center" Orientation="Vertical">
                                <TextBlock Text="{Binding SupportUnlock, StringFormat={}Unlock: {0}}" />
                                <TextBlock Text="{Binding SupportProof, StringFormat={}Code: {0}}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Support1"
                    SortMemberPath="Support1.Name"
                    >
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center">
                                <Hyperlink Command="{Binding DataContext.OpenSupportAsEditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding Support1}">
                                    <TextBlock Text="{Binding Support1.Name}" />
                                </Hyperlink>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Support2"
                    SortMemberPath="Support2.Name"
                    >
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center">
                                <Hyperlink Command="{Binding DataContext.OpenSupportAsEditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding Support2}">
                                    <TextBlock Text="{Binding Support2.Name}" />
                                </Hyperlink>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Support3"
                    SortMemberPath="Support3.Name"
                    >
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center">
                                <Hyperlink Command="{Binding DataContext.OpenSupportAsEditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding Support3}">
                                    <TextBlock Text="{Binding Support3.Name}" />
                                </Hyperlink>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Support4"
                    SortMemberPath="Support4.Name"
                    >
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center">
                                <Hyperlink Command="{Binding DataContext.OpenSupportAsEditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding Support4}">
                                    <TextBlock Text="{Binding Support4.Name}" />
                                </Hyperlink>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Co-Unit1"
                    SortMemberPath="CoMobile1.Name"
                    >
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center">
                                <Hyperlink Command="{Binding DataContext.OpenCoMobileAsEditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding CoMobile1}">
                                    <TextBlock Text="{Binding CoMobile1.Name}" />
                                </Hyperlink>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Co-Unit2"
                    SortMemberPath="CoMobile2.Name"
                    >
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center">
                                <Hyperlink Command="{Binding DataContext.OpenCoMobileAsEditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding CoMobile2}">
                                    <TextBlock Text="{Binding CoMobile2.Name}" />
                                </Hyperlink>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Co-Unit3"
                    SortMemberPath="CoMobile3.Name"
                    >
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center">
                                <Hyperlink Command="{Binding DataContext.OpenCoMobileAsEditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding CoMobile3}">
                                    <TextBlock Text="{Binding CoMobile3.Name}" />
                                </Hyperlink>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Cuspa">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Row="0" Grid.Column="0" Margin="0 0 4 4" Style="{StaticResource GwBorder}">
                                    <TextBlock VerticalAlignment="Center" Text="{Binding Cuspa1.Name}" />
                                </Border>
                                <Border Grid.Row="0" Grid.Column="1" Margin="0 0 4 4" Style="{StaticResource GwBorder}">
                                    <TextBlock VerticalAlignment="Center" Text="{Binding Cuspa2.Name}" />
                                </Border>
                                <Border Grid.Row="0" Grid.Column="2" Margin="0 0 0 4" Style="{StaticResource GwBorder}">
                                    <TextBlock VerticalAlignment="Center" Text="{Binding Cuspa3.Name}" />
                                </Border>
                                <Border Grid.Row="1" Grid.Column="0" Margin="0 0 4 0" Style="{StaticResource GwBorder}">
                                    <TextBlock VerticalAlignment="Center" Text="{Binding Cuspa4.Name}" />
                                </Border>
                                <Border Grid.Row="1" Grid.Column="1" Margin="0 0 4 0" Style="{StaticResource GwBorder}">
                                    <TextBlock VerticalAlignment="Center" Text="{Binding Cuspa5.Name}" />
                                </Border>
                                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource GwBorder}">
                                    <TextBlock VerticalAlignment="Center" Text="{Binding Cuspa6.Name}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="S-Cuspa">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Row="0" Grid.Column="0" Margin="0 0 4 4" Style="{StaticResource GwBorder}">
                                    <TextBlock VerticalAlignment="Center" Text="{Binding SCuspa1.Name}" />
                                </Border>
                                <Border Grid.Row="1" Grid.Column="0" Margin="0 0 4 0" Style="{StaticResource GwBorder}">
                                    <TextBlock VerticalAlignment="Center" Text="{Binding SCuspa2.Name}" />
                                </Border>
                                <Border Grid.Row="0" Grid.Column="1" Margin="0 0 0 4" Style="{StaticResource GwBorder}">
                                    <TextBlock VerticalAlignment="Center" Text="{Binding SCuspa3.Name}" />
                                </Border>
                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource GwBorder}">
                                    <TextBlock VerticalAlignment="Center" Text="{Binding SCuspa4.Name}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Grade"
                    SortMemberPath="Grade.Value"
                    >
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                            <Setter Property="ToolTip" Value="☆5: 40&#10;☆6: 50&#10;★1: 1&#10;★2: 2&#10;★3: 4&#10;★4: 7&#10;★5: 11"/>
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel VerticalAlignment="Center" Orientation="Vertical">
                                <ContentControl Content="{Binding Grade}" ContentTemplate="{StaticResource GwGradeTemplate}" />
                                <TextBlock Text="{Binding Blueprint, StringFormat={}Blueprint: {0}}" />
                                <TextBlock Text="{Binding Proof, StringFormat={}Proof: {0}}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Level"
                    ElementStyle="{StaticResource GwListRightTextColumn}"
                    Binding="{Binding Level}"
                />

                <DataGridTextColumn Header="Series"
                    ElementStyle="{StaticResource GwListTextColumn}"
                    Binding="{Binding Serial.Name}"
                    SortMemberPath="Serial.Order"
                />
                <DataGridTextColumn Header="Sub Series"
                    ElementStyle="{StaticResource GwListTextColumn}"
                    Binding="{Binding SubSerialsText}"
                />
                <DataGridTextColumn Header="Tags"
                    ElementStyle="{StaticResource GwListTextColumn}"
                    Binding="{Binding TagsText}"
                />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
