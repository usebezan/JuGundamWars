<UserControl x:Class="Ju.GundamWars.CoMobiles.View.CoMobileEntryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mahApps="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    xmlns:core="clr-namespace:Ju.GundamWars;assembly=Ju.GundamWars.Core"
    xmlns:coMobiles="clr-namespace:Ju.GundamWars.CoMobiles.View"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance coMobiles:CoMobileEntryViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    >
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Height="50" Orientation="Horizontal">
            <Button Style="{StaticResource GwCancelButton}" HorizontalAlignment="Left" VerticalAlignment="Center" />
        </StackPanel>
        <Grid />
    </DockPanel>
</UserControl>
