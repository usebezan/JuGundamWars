<UserControl x:Class="Ju.GundamWars.CoMobiles.View.CoMobileDataGridView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mahApps="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    xmlns:core="clr-namespace:Ju.GundamWars;assembly=Ju.GundamWars.Core"
    xmlns:commons="clr-namespace:Ju.GundamWars.Commons.View"
    xmlns:coMobiles="clr-namespace:Ju.GundamWars.CoMobiles.View"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance coMobiles:CoMobileListViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    >
    <Grid>
        <DataGrid ItemsSource="{Binding ItemsView}" FrozenColumnCount="2">
            <DataGrid.Columns>
                <DataGridTemplateColumn CellTemplate="{StaticResource GwList.CheckTemplate}" />
                <DataGridTemplateColumn Header="{x:Static core:GwText.Name}"
                    CellTemplate="{StaticResource GwList.CoMobileNameCellTemplate}"
                    SortMemberPath="Name"
                    SortDirection="Ascending"
                />
                <!-- TODO: 
                <DataGridTextColumn Header="Mobile"
                    ElementStyle="{StaticResource GwList.TextColumn}"
                    Binding="{Binding Mobile.Name}"
                    Width="120"
                />
                -->
                <DataGridTextColumn Header="{x:Static core:GwText.Hp}"
                    ElementStyle="{StaticResource GwList.RightTextColumn}"
                    Binding="{Binding ActualStatus.Hp, StringFormat={}{0:N0}, Mode=OneWay}"
                />
                <DataGridTextColumn
                    ElementStyle="{StaticResource GwList.TextColumn}"
                    Binding="{Binding UpgradedCount.HpText, Mode=OneWay}"
                    SortMemberPath="UpgradedCount.Hp"
                    >
                    <DataGridTextColumn.Header>
                        <TextBlock>
                            <Run Text="{x:Static core:GwText.Upgraded}" />
                            <LineBreak />
                            <Run Text="{x:Static core:GwText.Hp}" />
                        </TextBlock>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Header="{x:Static core:GwText.BeamAttack}"
                    ElementStyle="{StaticResource GwList.RightTextColumn}"
                    Binding="{Binding ActualStatus.BeamAttack, StringFormat={}{0:N0}, Mode=OneWay}"
                />
                <DataGridTextColumn
                    ElementStyle="{StaticResource GwList.TextColumn}"
                    Binding="{Binding UpgradedCount.BeamAttackText, Mode=OneWay}"
                    SortMemberPath="UpgradedCount.BeamAttack"
                    >
                    <DataGridTextColumn.Header>
                        <TextBlock>
                            <Run Text="{x:Static core:GwText.Upgraded}" />
                            <LineBreak />
                            <Run Text="{x:Static core:GwText.BeamAttack}" />
                        </TextBlock>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Header="{x:Static core:GwText.PhysicalAttack}"
                    ElementStyle="{StaticResource GwList.RightTextColumn}"
                    Binding="{Binding ActualStatus.PhysicalAttack, StringFormat={}{0:N0}, Mode=OneWay}"
                />
                <DataGridTextColumn
                    ElementStyle="{StaticResource GwList.TextColumn}"
                    Binding="{Binding UpgradedCount.PhysicalAttackText, Mode=OneWay}"
                    SortMemberPath="UpgradedCount.PhysicalAttack"
                    >
                    <DataGridTextColumn.Header>
                        <TextBlock>
                            <Run Text="{x:Static core:GwText.Upgraded}" />
                            <LineBreak />
                            <Run Text="{x:Static core:GwText.PhysicalAttack}" />
                        </TextBlock>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Header="{x:Static core:GwText.BeamDefence}"
                    ElementStyle="{StaticResource GwList.RightTextColumn}"
                    Binding="{Binding ActualStatus.BeamDefence, StringFormat={}{0:N0}, Mode=OneWay}"
                />
                <DataGridTextColumn
                    ElementStyle="{StaticResource GwList.TextColumn}"
                    Binding="{Binding UpgradedCount.BeamDefenceText, Mode=OneWay}"
                    SortMemberPath="UpgradedCount.BeamDefence"
                    >
                    <DataGridTextColumn.Header>
                        <TextBlock>
                            <Run Text="{x:Static core:GwText.Upgraded}" />
                            <LineBreak />
                            <Run Text="{x:Static core:GwText.BeamDefence}" />
                        </TextBlock>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Header="{x:Static core:GwText.PhysicalDefence}"
                    ElementStyle="{StaticResource GwList.RightTextColumn}"
                    Binding="{Binding ActualStatus.PhysicalDefence, StringFormat={}{0:N0}, Mode=OneWay}"
                />
                <DataGridTextColumn
                    ElementStyle="{StaticResource GwList.TextColumn}"
                    Binding="{Binding UpgradedCount.PhysicalDefenceText, Mode=OneWay}"
                    SortMemberPath="UpgradedCount.PhysicalDefence"
                    >
                    <DataGridTextColumn.Header>
                        <TextBlock>
                            <Run Text="{x:Static core:GwText.Upgraded}" />
                            <LineBreak />
                            <Run Text="{x:Static core:GwText.PhysicalDefence}" />
                        </TextBlock>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Header="{x:Static core:GwText.CriticalDamage}"
                    ElementStyle="{StaticResource GwList.RightTextColumn}"
                    Binding="{Binding ActualStatus.CriticalDamage, StringFormat={}{0:N0}, Mode=OneWay}"
                />
                <DataGridTextColumn
                    ElementStyle="{StaticResource GwList.TextColumn}"
                    Binding="{Binding UpgradedCount.CriticalDamageText, Mode=OneWay}"
                    SortMemberPath="UpgradedCount.CriticalDamage"
                    >
                    <DataGridTextColumn.Header>
                        <TextBlock>
                            <Run Text="{x:Static core:GwText.Upgraded}" />
                            <LineBreak />
                            <Run Text="{x:Static core:GwText.CriticalDamage}" />
                        </TextBlock>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Header="{x:Static core:GwText.Accuracy}"
                    ElementStyle="{StaticResource GwList.RightTextColumn}"
                    Binding="{Binding ActualStatus.Accuracy, StringFormat={}{0:N0}, Mode=OneWay}"
                />
                <DataGridTextColumn
                    ElementStyle="{StaticResource GwList.TextColumn}"
                    Binding="{Binding UpgradedCount.AccuracyText, Mode=OneWay}"
                    SortMemberPath="UpgradedCount.Accuracy"
                    >
                    <DataGridTextColumn.Header>
                        <TextBlock>
                            <Run Text="{x:Static core:GwText.Upgraded}" />
                            <LineBreak />
                            <Run Text="{x:Static core:GwText.Accuracy}" />
                        </TextBlock>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Header="{x:Static core:GwText.Evasion}"
                    ElementStyle="{StaticResource GwList.RightTextColumn}"
                    Binding="{Binding ActualStatus.Evasion, StringFormat={}{0:N0}, Mode=OneWay}"
                />
                <DataGridTextColumn
                    ElementStyle="{StaticResource GwList.TextColumn}"
                    Binding="{Binding UpgradedCount.EvasionText, Mode=OneWay}"
                    SortMemberPath="UpgradedCount.Evasion"
                    >
                    <DataGridTextColumn.Header>
                        <TextBlock>
                            <Run Text="{x:Static core:GwText.Upgraded}" />
                            <LineBreak />
                            <Run Text="{x:Static core:GwText.Evasion}" />
                        </TextBlock>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Header="{x:Static core:GwText.Mobility}"
                    ElementStyle="{StaticResource GwList.RightTextColumn}"
                    Binding="{Binding ActualStatus.Mobility, StringFormat={}{0:N0}, Mode=OneWay}"
                />
                <DataGridTextColumn
                    ElementStyle="{StaticResource GwList.TextColumn}"
                    Binding="{Binding UpgradedCount.MobilityText, Mode=OneWay}"
                    SortMemberPath="UpgradedCount.Mobility"
                    >
                    <DataGridTextColumn.Header>
                        <TextBlock>
                            <Run Text="{x:Static core:GwText.Upgraded}" />
                            <LineBreak />
                            <Run Text="{x:Static core:GwText.Mobility}" />
                        </TextBlock>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn
                    ElementStyle="{StaticResource GwList.TextColumn}"
                    Binding="{Binding UpgradedCount.StartupText, Mode=OneWay}"
                    SortMemberPath="UpgradedCount.Startup"
                    >
                    <DataGridTextColumn.Header>
                        <TextBlock>
                            <Run Text="{x:Static core:GwText.Upgraded}" />
                            <LineBreak />
                            <Run Text="{x:Static core:GwText.Startup}" />
                        </TextBlock>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn
                    ElementStyle="{StaticResource GwList.TextColumn}"
                    Binding="{Binding UpgradedCount.SuperMoveText, Mode=OneWay}"
                    SortMemberPath="UpgradedCount.SuperMove"
                    >
                    <DataGridTextColumn.Header>
                        <TextBlock>
                            <Run Text="{x:Static core:GwText.Upgraded}" />
                            <LineBreak />
                            <Run Text="{x:Static core:GwText.SuperMove}" />
                        </TextBlock>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Header="改修&#x0a;回数"
                    ElementStyle="{StaticResource GwList.RightTextColumn}"
                    Binding="{Binding UpgradedCountTotal, Mode=OneWay}"
                />
                <DataGridTextColumn Header="{x:Static core:GwText.Level}"
                    ElementStyle="{StaticResource GwList.RightTextColumn}"
                    Binding="{Binding Level, Mode=OneWay}"
                />
                <DataGridTextColumn Header="{x:Static core:GwText.Role}"
                    ElementStyle="{StaticResource GwList.TextColumn}"
                    Binding="{Binding Role.Name, Mode=OneWay}"
                    SortMemberPath="Role.Value"
                />
                <DataGridTextColumn Header="{x:Static core:GwText.Serial}"
                    ElementStyle="{StaticResource GwList.TextColumn}"
                    Binding="{Binding Serial.Name, Mode=OneWay}"
                    SortMemberPath="Serial.Order"
                />
                <DataGridTextColumn Header="{x:Static core:GwText.Tag}"
                    ElementStyle="{StaticResource GwList.TextColumn}"
                    Binding="{Binding TagsText, Mode=OneWay}"
                />
            </DataGrid.Columns>
        </DataGrid>
        <materialDesign:PopupBox Margin="16" HorizontalAlignment="Left" VerticalAlignment="Top">
            <StackPanel>
                <Button Command="{Binding CheckAllCommand, Mode=OneTime}" Content="すべて選択" />
                <Button Command="{Binding UncheckAllCommand, Mode=OneTime}" Content="すべて解除" />
            </StackPanel>
        </materialDesign:PopupBox>
    </Grid>
</UserControl>
