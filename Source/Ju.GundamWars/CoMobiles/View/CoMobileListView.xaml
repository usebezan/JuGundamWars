<UserControl x:Class="Ju.GundamWars.CoMobiles.View.CoMobileListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mahApps="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    xmlns:core="clr-namespace:Ju.GundamWars;assembly=Ju.GundamWars.Core"
    xmlns:commons="clr-namespace:Ju.GundamWars.Commons.View"
    xmlns:coMobiles="clr-namespace:Ju.GundamWars.CoMobiles.View"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance coMobiles:CoMobileListViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    >
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button
                    FontSize="14"
                    FontWeight="Medium"
                    Command="{Binding DataContext.OpenEntryAsNewCommand, RelativeSource={RelativeSource AncestorType={x:Type coMobiles:CoMobileView}}}"
                    >
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon VerticalAlignment="Center" Margin="0 0 8 0" Kind="PlusBoxOutline" />
                        <TextBlock VerticalAlignment="Center" Text="New" />
                    </StackPanel>
                </Button>
                <Separator Margin="4" />
                <Button
                    Command="{Binding DataContext.ClearFilterCommand, RelativeSource={RelativeSource AncestorType={x:Type coMobiles:CoMobileView}}}"
                    Content="{materialDesign:PackIcon FilterRemoveOutline}"
                    ToolTip="フィルター解除"
                />
                <ComboBox Style="{StaticResource GwFilterTagComboBox}" />
                <ToggleButton Style="{StaticResource GwFilterHasMemoToggleButton}" />
                <ToggleButton Style="{StaticResource GwFilterHasNoMobileToggleButton}" />
                <ToggleButton Style="{StaticResource GwFilterIsNotPinnedToggleButton}" />
                <ComboBox Style="{StaticResource GwFilterSerialComboBox}" />
            </ToolBar>
        </ToolBarTray>
        <commons:StatusBarView DockPanel.Dock="Bottom" />
        <coMobiles:CoMobileDataGridView />
    </DockPanel>
</UserControl>
