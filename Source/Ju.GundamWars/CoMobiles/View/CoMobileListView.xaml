<UserControl x:Class="Ju.GundamWars.CoMobiles.View.CoMobileListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mahApps="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    xmlns:core="clr-namespace:Ju.GundamWars;assembly=Ju.GundamWars.Core"
    xmlns:coMobiles="clr-namespace:Ju.GundamWars.CoMobiles.View"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance coMobiles:CoMobileListViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    >
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Command="{Binding OpenEntryAsNewCommand}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon VerticalAlignment="Center" Margin="0 0 8 0" Kind="PlusBoxOutline" />
                        <TextBlock VerticalAlignment="Center" Text="New" />
                    </StackPanel>
                </Button>
                <Separator Margin="4" />
                <Button Command="{Binding FilterClearCommand}" Content="{materialDesign:PackIcon FilterRemoveOutline}" ToolTip="フィルター解除" />
                <ComboBox Style="{StaticResource GwFilterSerialComboBox}" />
                <ComboBox Style="{StaticResource GwFilterTagComboBox}" />
                <ToggleButton Style="{StaticResource GwFilterHasMemoToggleButton}" />
                <ToggleButton Style="{StaticResource GwFilterHasNoMobileToggleButton}" />
                <ToggleButton Style="{StaticResource GwFilterIsNotPinnedToggleButton}" />
            </ToolBar>
        </ToolBarTray>
        <StatusBar DockPanel.Dock="Bottom" Margin="2 0 0 2" Height="24" Padding="4 0" Background="Transparent">
            <StatusBarItem >
                <TextBlock Margin="0" VerticalAlignment="Center">
                    <Run Text="{Binding ItemsView.Count, Mode=OneWay}"/>
                    <Run Text="items" />
                    <Run Text="/" />
                    <Run Text="{Binding FilteredCheckedCount, Mode=OneWay}"/>
                    <Run Text="checked" />
                    <Run Text="(" />
                    <Run Text="{Binding Items.Count, Mode=OneWay}"/>
                    <Run Text="items" />
                    <Run Text="/" />
                    <Run Text="{Binding CheckedCount, Mode=OneWay}"/>
                    <Run Text="checked" />
                    <Run Text=")" />
                </TextBlock>
            </StatusBarItem>
        </StatusBar>
        <coMobiles:CoMobileDataGridView />
    </DockPanel>
</UserControl>
