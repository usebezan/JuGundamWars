<UserControl x:Class="Ju.GundamWars.Commons.View.ProgressView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mahApps="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    xmlns:commons="clr-namespace:Ju.GundamWars.Commons.View"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance commons:ProgressViewModel}"
    >
    <Grid Width="280" Background="#ff6A715A">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="40" />
            <RowDefinition Height="48" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="1" Background="#ff273756">
            <Button
                Style="{StaticResource MaterialDesignFloatingActionButton}"
                Width="32"
                Height="32"
                Background="#ffEF9EC7"
                BorderBrush="#ffEF9EC7"
                materialDesign:ButtonProgressAssist.IsIndeterminate="{Binding IsIndeterminate}"
                materialDesign:ButtonProgressAssist.IsIndicatorVisible="True"
                materialDesign:ButtonProgressAssist.Value="0"
                materialDesign:ButtonProgressAssist.IndicatorForeground="#ffEF9EC7"
                materialDesign:ElevationAssist.Elevation="Dp0"
                IsHitTestVisible="False"
            />
            <Grid Margin="8 0 0 0" HorizontalAlignment="Left" Width="20" Background="#ff6A715A" />
            <Grid Margin="0 0 8 0" HorizontalAlignment="Right" Width="20" Background="#ff6A715A" />
        </Grid>
        <TextBlock Grid.Row="2" Style="{StaticResource MaterialDesignHeadline5TextBlock}" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Message}" />
    </Grid>
</UserControl>
