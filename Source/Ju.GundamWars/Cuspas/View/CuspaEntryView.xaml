<UserControl x:Class="Ju.GundamWars.Cuspas.View.CuspaEntryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mahApps="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    xmlns:core="clr-namespace:Ju.GundamWars;assembly=Ju.GundamWars.Core"
    xmlns:commons="clr-namespace:Ju.GundamWars.Commons.View"
    xmlns:cuspas="clr-namespace:Ju.GundamWars.Cuspas.View"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance cuspas:CuspaEntryViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    >
    <UserControl.Resources>
        <Style TargetType="{x:Type GroupBox}" BasedOn="{StaticResource GwEntry.GroupBox}" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Height="50" Orientation="Horizontal">
            <Button Style="{StaticResource GwEntry.CancelButton}" Command="{Binding CancelCommand}" />
            <Button Style="{StaticResource GwEntry.EnterButton}" Command="{Binding EnterCommand}" />
            <Button Style="{StaticResource GwEntry.DeleteButton}" Command="{Binding DeleteCommand}" />
        </StackPanel>
        <Grid Grid.Row="1" Grid.Column="0" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <GroupBox Grid.Row="0" Margin="0 0 0 16" HorizontalAlignment="Left" Header="{x:Static core:GwText.Name}">
                <TextBlock Style="{StaticResource GwEntry.TextBlock}" Text="{Binding Model.Name}" />
            </GroupBox>
            <TabControl Grid.Row="1" SelectedIndex="{Binding TabIndex}">
                <TabItem Header="Default">
                    <cuspas:CuspaEntryDefaultView Margin="0 16 0 0" />
                </TabItem>
                <TabItem Header="Leveling">
                    <cuspas:CuspaEntryLevelingView Margin="0 16 0 0" />
                </TabItem>
                <TabItem Header="Custom">
                    <cuspas:CuspaEntryCustomView Margin="0 16 0 0" />
                </TabItem>
            </TabControl>
        </Grid>
        <!--<ScrollViewer Grid.Row="1" Grid.Column="1" Margin="16 0 0 0" VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource GwSummaryBorder}" DataContext="{Binding Entry}">
                <local:CuspaSummaryUserControl />
            </Border>
        </ScrollViewer>-->
    </Grid>
</UserControl>
