<UserControl x:Class="Ju.GundamWars.Cuspas.View.CuspaEntryLevelingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mahApps="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    xmlns:core="clr-namespace:Ju.GundamWars;assembly=Ju.GundamWars.Core"
    xmlns:commons="clr-namespace:Ju.GundamWars.Commons.View"
    xmlns:cuspas="clr-namespace:Ju.GundamWars.Cuspas.View"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance cuspas:CuspaListViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    >
    <ScrollViewer VerticalScrollBarVisibility="Visible">
        <StackPanel>
            <GroupBox Header="{x:Static core:GwText.Level}">
                <TextBox Style="{StaticResource GwEntry.LevelTextBox}" />
            </GroupBox>
            <GroupBox Header="{x:Static core:GwText.BasicStatus}">
                <cuspas:CuspaEntryStatusView DataContext="{Binding Model.BasicStatus}" />
            </GroupBox>
            <GroupBox Header="{x:Static core:GwText.BonusStatus}">
                <cuspas:CuspaEntryStatusView DataContext="{Binding Model.BonusStatus}" />
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
