<UserControl x:Class="Ju.GundamWars.Cuspas.View.CuspaListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mahApps="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    xmlns:core="clr-namespace:Ju.GundamWars;assembly=Ju.GundamWars.Core"
    xmlns:commons="clr-namespace:Ju.GundamWars.Commons.View"
    xmlns:cuspas="clr-namespace:Ju.GundamWars.Cuspas.View"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance cuspas:CuspaListViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    >
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <materialDesign:SplitButton
                    Style="{StaticResource MaterialDesignFlatSplitButton}"
                    Command="{Binding DataContext.OpenEntryAsNewCommand, RelativeSource={StaticResource GwCuspaListRelativeSource}}"
                    PopupPlacementMode="BottomAndAlignRightEdges"
                    >
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon VerticalAlignment="Center" Margin="0 0 8 0" Kind="PlusBoxOutline" />
                        <TextBlock VerticalAlignment="Center" Text="New" />
                    </StackPanel>
                    <materialDesign:SplitButton.PopupContent>
                        <StackPanel>
                            <Button
                                Command="{Binding DataContext.OpenEntryAsNewCommand, RelativeSource={StaticResource GwCuspaListRelativeSource}}"
                                >
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon VerticalAlignment="Center" Margin="0 0 8 0" Kind="{Binding Source={x:Static core:GwIcon.Mobile}}" />
                                    <TextBlock VerticalAlignment="Center" Text="{Binding Source={x:Static core:GwText.Mobile}}" />
                                </StackPanel>
                            </Button>
                            <Button
                                Command="{Binding DataContext.OpenEntryAsNewForBsCommand, RelativeSource={StaticResource GwCuspaListRelativeSource}}"
                                >
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon VerticalAlignment="Center" Margin="0 0 8 0" Kind="{Binding Source={x:Static core:GwIcon.Battleship}}" />
                                    <TextBlock VerticalAlignment="Center" Text="{Binding Source={x:Static core:GwText.Battleship}}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </materialDesign:SplitButton.PopupContent>
                </materialDesign:SplitButton>
                <Separator Margin="4" />
                <Button
                    Command="{Binding DataContext.ClearFilterCommand, RelativeSource={StaticResource GwCuspaListRelativeSource}}"
                    Content="{materialDesign:PackIcon FilterRemoveOutline}"
                    ToolTip="フィルター解除"
                />
                <ComboBox Style="{StaticResource GwFilter.ForUnitComboBox}" />
                <ComboBox Style="{StaticResource GwFilter.TagComboBox}" />
                <ComboBox Style="{StaticResource GwFilter.CuspaKindComboBox}" />
                <ComboBox Style="{StaticResource GwFilter.BoostStatusComboBox}" />
                <ToggleButton Style="{StaticResource GwFilter.HasMemoToggleButton}" />
            </ToolBar>
        </ToolBarTray>
        <commons:StatusBarView DockPanel.Dock="Bottom" />
        <cuspas:CuspaDataGridView />
    </DockPanel>
</UserControl>
