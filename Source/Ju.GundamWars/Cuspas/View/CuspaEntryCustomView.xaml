<UserControl x:Class="Ju.GundamWars.Cuspas.View.CuspaEntryCustomView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mahApps="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    xmlns:core="clr-namespace:Ju.GundamWars;assembly=Ju.GundamWars.Core"
    xmlns:commons="clr-namespace:Ju.GundamWars.Commons.View"
    xmlns:cuspas="clr-namespace:Ju.GundamWars.Cuspas.View"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance cuspas:CuspaListViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    >
    <ScrollViewer VerticalScrollBarVisibility="Visible">
        <StackPanel>
            <GroupBox Header="{Binding}">
                <GroupBox.HeaderTemplate>
                    <DataTemplate>
                        <DockPanel Height="24">
                            <Button
                                DockPanel.Dock="Right"
                                Style="{StaticResource GwEntry.ToolButton}"
                                Command="{Binding UncheckAllTagsCommand, Mode=OneTime}"
                                Content="{materialDesign:PackIcon CircleOutline}"
                                ToolTip="すべて解除"
                            />
                            <TextBlock Text="{x:Static core:GwText.Tag}" />
                        </DockPanel>
                    </DataTemplate>
                </GroupBox.HeaderTemplate>
                <ListBox Style="{StaticResource GwEntry.TagListBox}" />
            </GroupBox>
            <GroupBox Header="{x:Static core:GwText.Memo}">
                <TextBox Style="{StaticResource GwEntry.MemoTextBox}" />
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
