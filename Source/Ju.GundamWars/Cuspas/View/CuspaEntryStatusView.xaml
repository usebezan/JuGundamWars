<UserControl x:Class="Ju.GundamWars.Cuspas.View.CuspaEntryStatusView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mahApps="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    xmlns:core="clr-namespace:Ju.GundamWars;assembly=Ju.GundamWars.Core"
    xmlns:commons="clr-namespace:Ju.GundamWars.Commons.View"
    xmlns:cuspas="clr-namespace:Ju.GundamWars.Cuspas.View"
    xmlns:cuspasDm="clr-namespace:Ju.GundamWars.Client.Cuspas.Domain;assembly=Ju.GundamWars.Client.Transaction"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance cuspasDm:CuspaStatus}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    >
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBox Grid.Column="0" Grid.Row="0" Style="{StaticResource GwEntry.StatusTextBox}" Text="{Binding Hp}" materialDesign:TextFieldAssist.PrefixText="{x:Static core:GwText.Hp}" />
        <TextBox Grid.Column="1" Grid.Row="0" Style="{StaticResource GwEntry.StatusTextBox}" Text="{Binding BeamAttack}" materialDesign:TextFieldAssist.PrefixText="{x:Static core:GwText.BeamAttack}" />
        <TextBox Grid.Column="2" Grid.Row="0" Style="{StaticResource GwEntry.StatusTextBox}" Text="{Binding PhysicalAttack}" materialDesign:TextFieldAssist.PrefixText="{x:Static core:GwText.PhysicalAttack}" />
        <TextBox Grid.Column="0" Grid.Row="1" Style="{StaticResource GwEntry.StatusTextBox}" Text="{Binding BeamDefence}" materialDesign:TextFieldAssist.PrefixText="{x:Static core:GwText.BeamDefence}" />
        <TextBox Grid.Column="1" Grid.Row="1" Style="{StaticResource GwEntry.StatusTextBox}" Text="{Binding PhysicalDefence}" materialDesign:TextFieldAssist.PrefixText="{x:Static core:GwText.PhysicalDefence}" />
        <TextBox Grid.Column="2" Grid.Row="1" Style="{StaticResource GwEntry.StatusTextBox}" Text="{Binding CriticalRate}" materialDesign:TextFieldAssist.PrefixText="{x:Static core:GwText.CriticalRate}" />
        <TextBox Grid.Column="0" Grid.Row="2" Style="{StaticResource GwEntry.StatusTextBox}" Text="{Binding CriticalDamage}" materialDesign:TextFieldAssist.PrefixText="{x:Static core:GwText.CriticalDamage}" />
        <TextBox Grid.Column="1" Grid.Row="2" Style="{StaticResource GwEntry.StatusTextBox}" Text="{Binding Accuracy}" materialDesign:TextFieldAssist.PrefixText="{x:Static core:GwText.Accuracy}" />
        <TextBox Grid.Column="2" Grid.Row="2" Style="{StaticResource GwEntry.StatusTextBox}" Text="{Binding Evasion}" materialDesign:TextFieldAssist.PrefixText="{x:Static core:GwText.Evasion}" />
        <TextBox Grid.Column="0" Grid.Row="3" Style="{StaticResource GwEntry.StatusTextBox}" Text="{Binding Mobility}" materialDesign:TextFieldAssist.PrefixText="{x:Static core:GwText.Mobility}" />
        <TextBox Grid.Column="1" Grid.Row="3" Style="{StaticResource GwEntry.StatusTextBox}" Text="{Binding EnRecovery}" materialDesign:TextFieldAssist.PrefixText="{x:Static core:GwText.EnRecovery}" />
    </Grid>
</UserControl>
