<UserControl x:Class="Ju.GundamWars.Cuspas.View.CuspaDataGridView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mahApps="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    xmlns:core="clr-namespace:Ju.GundamWars;assembly=Ju.GundamWars.Core"
    xmlns:commons="clr-namespace:Ju.GundamWars.Commons.View"
    xmlns:cuspas="clr-namespace:Ju.GundamWars.Cuspas.View"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance cuspas:CuspaListViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    >
    <DataGrid ItemsSource="{Binding ItemsView}" FrozenColumnCount="1">
        <DataGrid.Columns>
            <DataGridTemplateColumn Header="{x:Static core:GwText.Name}"
                CellTemplate="{StaticResource GwList.CuspaNameCellTemplate}"
                SortMemberPath="Name"
                SortDirection="Ascending"
            />
            <DataGridTextColumn Header="{x:Static core:GwText.Hp}"
                ElementStyle="{StaticResource GwList.RightTextColumn}"
                Binding="{Binding ActualStatus.Hp, StringFormat={}{0:N0}, Mode=OneWay}"
            />
            <DataGridTextColumn Header="{x:Static core:GwText.BeamAttack}"
                ElementStyle="{StaticResource GwList.RightTextColumn}"
                Binding="{Binding ActualStatus.BeamAttack, StringFormat={}{0:N0}, Mode=OneWay}"
            />
            <DataGridTextColumn Header="{x:Static core:GwText.PhysicalAttack}"
                ElementStyle="{StaticResource GwList.RightTextColumn}"
                Binding="{Binding ActualStatus.PhysicalAttack, StringFormat={}{0:N0}, Mode=OneWay}"
            />
            <DataGridTextColumn Header="{x:Static core:GwText.BeamDefence}"
                ElementStyle="{StaticResource GwList.RightTextColumn}"
                Binding="{Binding ActualStatus.BeamDefence, StringFormat={}{0:N0}, Mode=OneWay}"
            />
            <DataGridTextColumn Header="{x:Static core:GwText.PhysicalDefence}"
                ElementStyle="{StaticResource GwList.RightTextColumn}"
                Binding="{Binding ActualStatus.PhysicalDefence, StringFormat={}{0:N0}, Mode=OneWay}"
            />
            <DataGridTextColumn Header="{x:Static core:GwText.CriticalRate}"
                ElementStyle="{StaticResource GwList.RightTextColumn}"
                Binding="{Binding ActualStatus.CriticalRate, StringFormat={}{0:N0}%, Mode=OneWay}"
            />
            <DataGridTextColumn Header="{x:Static core:GwText.CriticalDamage}"
                    ElementStyle="{StaticResource GwList.RightTextColumn}"
                    Binding="{Binding ActualStatus.CriticalDamage, StringFormat={}{0:N0}, Mode=OneWay}"
                />
            <DataGridTextColumn Header="{x:Static core:GwText.Accuracy}"
                ElementStyle="{StaticResource GwList.RightTextColumn}"
                Binding="{Binding ActualStatus.Accuracy, StringFormat={}{0:N0}, Mode=OneWay}"
            />
            <DataGridTextColumn Header="{x:Static core:GwText.Evasion}"
                ElementStyle="{StaticResource GwList.RightTextColumn}"
                Binding="{Binding ActualStatus.Evasion, StringFormat={}{0:N0}, Mode=OneWay}"
            />
            <DataGridTextColumn Header="{x:Static core:GwText.Mobility}"
                ElementStyle="{StaticResource GwList.RightTextColumn}"
                Binding="{Binding ActualStatus.Mobility, StringFormat={}{0:N0}, Mode=OneWay}"
            />
            <DataGridTextColumn Header="{x:Static core:GwText.EnRecovery}"
                ElementStyle="{StaticResource GwList.RightTextColumn}"
                Binding="{Binding ActualStatus.EnRecovery, StringFormat={}{0:N0}, Mode=OneWay}"
            />
            <DataGridTextColumn Header="{x:Static core:GwText.Level}"
                ElementStyle="{StaticResource GwList.RightTextColumn}"
                Binding="{Binding Level, Mode=OneWay}"
            />
            <DataGridTextColumn Header="{x:Static core:GwText.Tag}"
                ElementStyle="{StaticResource GwList.TextColumn}"
                Binding="{Binding TagsText, Mode=OneWay}"
            />
        </DataGrid.Columns>
    </DataGrid>
</UserControl>
