<Application
    x:Class="Ju.GundamWars.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
    xmlns:assist="clr-namespace:Ju.GundamWars.Assists"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:const="clr-namespace:Ju.GundamWars.Const;assembly=Ju.GundamWars.Core"
    Startup="OnStartup"
    Exit="OnExit"
    >
    <Application.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>

                <!-- RX-93 νガンダム -->
                <!--白 #FAFAF8-->
                <!--黒 #13131F-->
                <!--黄 #F99427-->
                <!--赤 #E7233A-->
                <materialDesign:MahAppsCustomColorTheme BaseTheme="Dark" PrimaryColor="#F99427" SecondaryColor="#E7233A" ColorAdjustment="{materialDesign:ColorAdjustment}" />

                <!-- MahApps -->
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Fonts.xaml" />

                <!-- Material Design -->
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Snackbar.xaml" />
                <!-- Material Design: MahApps Compatibility -->
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.MahApps;component/Themes/MaterialDesignTheme.MahApps.Defaults.xaml"/>

            </ResourceDictionary.MergedDictionaries>

            <Color x:Key="GwForegroundColor">#ffFAFAF8</Color>
            <Color x:Key="GwBackgroundColor">#ff13131F</Color>
            <Color x:Key="GwBackground2Color">#ff27273f</Color>
            <Color x:Key="GwPrimaryColor">#ffF99427</Color>
            <Color x:Key="GwSecondaryColor">#ffE7233A</Color>
            <Color x:Key="GwErrorColor">#ffE7233A</Color>

            <!-- Overwrite Material Design Brushes -->
            <SolidColorBrush x:Key="ValidationErrorBrush" Color="{DynamicResource GwErrorColor}" />
            <SolidColorBrush x:Key="MaterialDesignBody" Color="{DynamicResource GwForegroundColor}" po:Freeze="True" />
            <SolidColorBrush x:Key="MaterialDesignPaper" Color="{DynamicResource GwBackgroundColor}" po:Freeze="True" />
            <SolidColorBrush x:Key="MaterialDesignCardBackground" Color="{DynamicResource GwBackground2Color}" po:Freeze="True" />

            <!-- GW Brushes -->
            <SolidColorBrush x:Key="GwCheckedBackground" Color="#FF16160e" />


            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />


            <!--#region primitive-->

            <Style x:Key="GwBorder" TargetType="{x:Type Border}">
                <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="8 0" />
            </Style>


            <Style x:Key="GwGroupBoxHeaderTextBlock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource MaterialDesignTextBlock}">
                <!--<Setter Property="VerticalAlignment" Value="Center" />-->
                <Setter Property="Text" Value="{Binding}" />
            </Style>

            <Style x:Key="GwGroupBox" TargetType="{x:Type GroupBox}" BasedOn="{StaticResource MaterialDesignCardGroupBox}">
                <Setter Property="Padding" Value="8 4" />
                <Setter Property="materialDesign:ColorZoneAssist.Mode" Value="Custom" />
                <Setter Property="materialDesign:ColorZoneAssist.Foreground" Value="{DynamicResource MaterialDesignBody}" />
                <Setter Property="materialDesign:ColorZoneAssist.Background" Value="Transparent" />
            </Style>


            <DataTemplate x:Key="GwComboBoxGroupHeaderTemplate">
                <TextBlock Padding="8 4" Text="{Binding Name}" Foreground="{DynamicResource PrimaryHueMidBrush}" />
            </DataTemplate>

            <Style x:Key="GwComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource MaterialDesignComboBox}">
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Height" Value="30" />
                <Setter Property="IsSynchronizedWithCurrentItem" Value="False" />
                <Setter Property="materialDesign:ValidationAssist.Background" Value="Transparent" />
            </Style>


            <Style x:Key="GwTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource MaterialDesignTextBox}">
                <Setter Property="Height" Value="30" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="materialDesign:ValidationAssist.Background" Value="Transparent" />
            </Style>

            
            <Style x:Key="GwToolBar" TargetType="{x:Type ToolBar}" BasedOn="{StaticResource MaterialDesignToolBar}">
                <Style.Resources>
                    <Style TargetType="{x:Type materialDesign:PackIcon}">
                        <Setter Property="FrameworkElement.Width" Value="16" />
                        <Setter Property="FrameworkElement.Height" Value="16" />
                    </Style>
                </Style.Resources>
                <Setter Property="Height" Value="48" />
                <Setter Property="ToolBarTray.IsLocked" Value="True" />
                <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
            </Style>


            <Style x:Key="GwDataGrid" TargetType="{x:Type DataGrid}" BasedOn="{StaticResource MaterialDesignDataGrid}">
                <Setter Property="AutoGenerateColumns" Value="False" />
                <Setter Property="CanUserAddRows" Value="False" />
                <Setter Property="CanUserDeleteRows" Value="False" />
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="GridLinesVisibility" Value="Horizontal" />
                <Setter Property="HeadersVisibility" Value="Column" />
                <Setter Property="SelectionMode" Value="Single" />
                <Setter Property="SelectionUnit" Value="Cell" />
                <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
                <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Standard" />
                <Setter Property="EnableRowVirtualization" Value="True" />
            </Style>

            <!--#endregion-->
            <!--#region complex-->

            <Style x:Key="GwIcon" TargetType="{x:Type ContentControl}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Grid Width="24" Height="24" Background="Transparent">
                                <materialDesign:PackIcon HorizontalAlignment="Center" VerticalAlignment="Center" Width="16" Height="16" Kind="{Binding Path=(assist:IconControlAttached.Icon), RelativeSource={RelativeSource TemplatedParent}, TargetNullValue='AlphaJCircleOutline'}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="GwBoostControl" TargetType="{x:Type ContentControl}">
                <Setter Property="Margin" Value="8 0 8 8" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Grid>
                                <TextBox
                                    Text="{Binding Path=(assist:BoostControlAttached.Text), RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                    Focusable="False"
                                    IsHitTestVisible="False"
                                    materialDesign:HintAssist.Hint="Select..."
                                />
                                <Button
                                    Style="{StaticResource MaterialDesignToolForegroundButton}"
                                    Height="Auto"
                                    Command="{Binding Path=(assist:BoostControlAttached.ShowCommand), RelativeSource={RelativeSource TemplatedParent}}"
                                    CommandParameter="{Binding Path=(assist:BoostControlAttached.Index), RelativeSource={RelativeSource TemplatedParent}}"
                                    materialDesign:RippleAssist.IsCentered="False"
                                    materialDesign:RippleAssist.ClipToBounds="True"
                                />
                                <Button x:Name="DetachedButton"
                                    Style="{StaticResource MaterialDesignToolButton}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Width="16"
                                    Height="16"
                                    Padding="0"
                                    Focusable="False"
                                    Visibility="Visible"
                                    Command="{Binding Path=(assist:BoostControlAttached.DetachCommand), RelativeSource={RelativeSource TemplatedParent}}"
                                    CommandParameter="{Binding Path=(assist:BoostControlAttached.Index), RelativeSource={RelativeSource TemplatedParent}}"
                                    Content="{materialDesign:PackIcon CloseCircle}"
                                />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="assist:BoostControlAttached.Text" Value="{x:Null}">
                                    <Setter TargetName="DetachedButton" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--#endregion-->
            <!--#region advanced-->

            <Style x:Key="GwTabIcon" TargetType="{x:Type materialDesign:PackIcon}">
                <Setter Property="FrameworkElement.Margin" Value="0 0 0 4" />
                <Setter Property="FrameworkElement.HorizontalAlignment" Value="Center" />
                <Setter Property="FrameworkElement.Width" Value="24" />
                <Setter Property="FrameworkElement.Height" Value="24" />
            </Style>

            <Style x:Key="GwTabText" TargetType="{x:Type TextBlock}">
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="12" />
            </Style>


            <DataTemplate x:Key="GwRecordIconTemplate">
                <StackPanel>
                    <materialDesign:PackIcon HorizontalAlignment="Center" Kind="{Binding Icon}" />
                    <TextBlock HorizontalAlignment="Center" Text="{Binding Name}" FontSize="10" />
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="GwRecordIconTextTemplate">
                <StackPanel Orientation="Horizontal" Height="24">
                    <ContentControl Style="{StaticResource GwIcon}" VerticalAlignment="Center" Margin="0 0 8 0" assist:IconControlAttached.Icon="{Binding Icon}" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                </StackPanel>
            </DataTemplate>


            <DataTemplate x:Key="GwGradeTemplate">
                <TextBlock VerticalAlignment="Center">
                    <Run Text="★" Foreground="{Binding GradeColor}" />
                    <Run Text="{Binding GradeText, Mode=OneWay}" />
                </TextBlock>
            </DataTemplate>


            <Style x:Key="GwOkButton" TargetType="{x:Type Button}" BasedOn="{StaticResource MaterialDesignFlatMidBgButton}" x:Shared="False">
                <Setter Property="Width" Value="100" />
                <Setter Property="Height" Value="32" />
                <Setter Property="FontFamily" Value="Yu Gothic UI" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="0" />
                <Setter Property="Command" Value="{x:Static materialDesign:DialogHost.CloseDialogCommand}" />
                <Setter Property="CommandParameter">
                    <Setter.Value>
                        <sys:Boolean>True</sys:Boolean>
                    </Setter.Value>
                </Setter>
                <Setter Property="Content" Value="Accept" />
                <Setter Property="IsDefault" Value="True" />
            </Style>

            <Style x:Key="GwCancelButton" TargetType="{x:Type Button}" BasedOn="{StaticResource MaterialDesignFlatButton}" x:Shared="False">
                <Setter Property="Width" Value="100" />
                <Setter Property="Height" Value="32" />
                <Setter Property="FontFamily" Value="Yu Gothic UI" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <!--<Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />-->
                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="0" />
                <Setter Property="Command" Value="{x:Static materialDesign:DialogHost.CloseDialogCommand}" />
                <Setter Property="CommandParameter">
                    <Setter.Value>
                        <sys:Boolean>False</sys:Boolean>
                    </Setter.Value>
                </Setter>
                <Setter Property="Content" Value="Reject" />
                <Setter Property="IsCancel" Value="True" />
            </Style>

            <Style x:Key="GwBackButton" TargetType="{x:Type Button}" BasedOn="{StaticResource MaterialDesignIconForegroundButton}" x:Shared="False">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Command" Value="{Binding CancelCommand}" />
                <Setter Property="ToolTip" Value="Cancel" />
                <Setter Property="Content">
                    <Setter.Value>
                        <materialDesign:PackIcon Kind="ArrowLeft" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="GwReloadButton" TargetType="{x:Type Button}" BasedOn="{StaticResource MaterialDesignIconForegroundButton}" x:Shared="False">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Command" Value="{Binding ReloadCommand}" />
                <Setter Property="ToolTip" Value="Reload" />
                <Setter Property="Content">
                    <Setter.Value>
                        <materialDesign:PackIcon Kind="Refresh" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="GwEntryEnterButton" TargetType="{x:Type Button}" BasedOn="{StaticResource MaterialDesignFlatMidBgButton}" x:Shared="False">
                <Setter Property="Width" Value="100" />
                <Setter Property="Height" Value="32" />
                <Setter Property="FontFamily" Value="Yu Gothic UI" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="0" />
                <Setter Property="Content" Value="Register" />
            </Style>

            <Style x:Key="GwEntryCancelButton" TargetType="{x:Type Button}" BasedOn="{StaticResource MaterialDesignFlatButton}" x:Shared="False">
                <Setter Property="Width" Value="100" />
                <Setter Property="Height" Value="32" />
                <Setter Property="FontFamily" Value="Yu Gothic UI" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="0" />
                <Setter Property="Content" Value="Cancel" />
                <Setter Property="IsCancel" Value="True" />
            </Style>

            <Style x:Key="GwEntryDeleteButton" TargetType="{x:Type Button}" BasedOn="{StaticResource MaterialDesignOutlinedSecondaryButton}" x:Shared="False">
                <Setter Property="Width" Value="100" />
                <Setter Property="Height" Value="32" />
                <Setter Property="FontFamily" Value="Yu Gothic UI" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Visibility" Value="{Binding IsEdit, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="0" />
                <Setter Property="Content">
                    <Setter.Value>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon VerticalAlignment="Center" Margin="0 0 8 0" Kind="MinusBoxOutline" />
                            <TextBlock VerticalAlignment="Center" Text="Delete" />
                        </StackPanel>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--#endregion-->

            <!--#region list primitive-->

            <Style x:Key="GwListTextColumn" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Style.Triggers>
                    <Trigger Property="Text" Value="0">
                        <Setter Property="Opacity" Value="0.2" />
                    </Trigger>
                    <Trigger Property="Text" Value="0%">
                        <Setter Property="Opacity" Value="0.2" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="GwListRightTextColumn" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource GwListTextColumn}">
                <Setter Property="HorizontalAlignment" Value="Right" />
            </Style>

            <!--#endregion-->
            <!--#region list advanced-->

            <DataTemplate x:Key="GwListNameTemplate">
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center">
                        <Hyperlink Command="{Binding DataContext.OpenEntryAsEditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                            <TextBlock Text="{Binding Name}" />
                        </Hyperlink>
                    </TextBlock>
                    <materialDesign:PackIcon x:Name="pin" Width="12" Margin="0 0 0 0" VerticalAlignment="Top" Kind="Pin" Visibility="Collapsed" />
                </StackPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                        <Setter TargetName="pin" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <DataTemplate x:Key="GwListNameTemplate2">
                <TextBlock VerticalAlignment="Center">
                    <Hyperlink Command="{Binding DataContext.OpenEntryAsEditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                        <TextBlock Text="{Binding Name}" />
                    </Hyperlink>
                </TextBlock>
            </DataTemplate>

            <!--<DataTemplate x:Key="GwListMemoTemplate">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ContentControl x:Name="pin" Grid.Row="0" Style="{StaticResource GwIcon}" HorizontalAlignment="Center" assist:IconControlAttached.Icon="Pin" Visibility="Hidden" />
                    <ContentControl x:Name="memo" Grid.Row="1" Style="{StaticResource GwIcon}" HorizontalAlignment="Center" assist:IconControlAttached.Icon="TooltipText" ToolTip="{Binding Memo}" Visibility="Hidden" />
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding HasMemo}" Value="True">
                        <Setter TargetName="memo" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                        <Setter TargetName="pin" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>-->
            <DataTemplate x:Key="GwListMemoTemplate">
                <ContentControl x:Name="memo" Grid.Row="1" Style="{StaticResource GwIcon}" HorizontalAlignment="Center" assist:IconControlAttached.Icon="TooltipText" ToolTip="{Binding Memo}" Visibility="Hidden" />
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding HasMemo}" Value="True">
                        <Setter TargetName="memo" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <Style x:Key="GwListCopyButton" TargetType="{x:Type Button}" BasedOn="{StaticResource MaterialDesignIconForegroundButton}" x:Shared="False">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Command" Value="{Binding DataContext.OpenEntryAsCopyCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                <Setter Property="CommandParameter" Value="{Binding}" />
                <Setter Property="ToolTip" Value="Copy" />
                <Setter Property="Content">
                    <Setter.Value>
                        <materialDesign:PackIcon Width="16" Height="16" Kind="ContentCopy" />
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="GwListNameCellTemplate">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ContentControl Grid.Column="0" VerticalAlignment="Center" Content="{Binding Category}" ContentTemplate="{StaticResource GwRecordIconTemplate}" />
                    <ContentControl Grid.Column="1" Margin="8 0 0 0" Content="{Binding}" ContentTemplate="{StaticResource GwListNameTemplate}" />
                    <ContentControl Grid.Column="2" Margin="4 0 0 0" Content="{Binding}" ContentTemplate="{StaticResource GwListMemoTemplate}" />
                    <Button Grid.Column="3" Margin="8 0 0 0" Style="{StaticResource GwListCopyButton}" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="GwListNameCellTemplate2">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ContentControl Grid.Column="0" VerticalAlignment="Center" Content="{Binding Category}" ContentTemplate="{StaticResource GwRecordIconTemplate}" />
                    <ContentControl Grid.Column="1" Margin="8 0 0 0" Content="{Binding}" ContentTemplate="{StaticResource GwListNameTemplate2}" />
                    <ContentControl Grid.Column="2" Margin="4 0 0 0" Content="{Binding}" ContentTemplate="{StaticResource GwListMemoTemplate}" />
                    <Button Grid.Column="3" Margin="8 0 0 0" Style="{StaticResource GwListCopyButton}" />
                </Grid>
            </DataTemplate>

            <!--#endregion-->

            <!--#region selection primitive-->
            <!--#endregion-->
            <!--#region selection advanced-->

            <Style x:Key="GwSelectionSelectButton" TargetType="{x:Type Button}" BasedOn="{StaticResource MaterialDesignIconForegroundButton}" x:Shared="False">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Command" Value="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                <Setter Property="CommandParameter" Value="{Binding}" />
                <Setter Property="ToolTip" Value="Select" />
                <Setter Property="Content">
                    <Setter.Value>
                        <materialDesign:PackIcon Width="16" Height="16" Kind="Check" />
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="GwSelectionDataGridNameTemplate">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Margin="0 0 4 0" Style="{StaticResource GwSelectionSelectButton}" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="4 0" Text="{Binding Name}" />
                    <ContentControl Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource GwListMemoTemplate}" />
                </Grid>
            </DataTemplate>

            <!--#endregion-->

            <!--#region filter primitive-->

            <Style x:Key="GwFilterComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource GwComboBox}">
                <Setter Property="Margin" Value="8" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="materialDesign:TextFieldAssist.HasClearButton" Value="True" />
            </Style>

            <!--#endregion-->
            <!--#region filter advanced-->

            <Style x:Key="GwFilterCheckedToggleButton" TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource MaterialDesignSwitchToggleButton}" x:Shared="False">
                <Setter Property="Margin" Value="8" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="IsChecked" Value="{Binding IsChecked}" />
                <Setter Property="ToolTip" Value="Is Checked" />
                <Setter Property="Content">
                    <Setter.Value>
                        <materialDesign:PackIcon Kind="Check" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="GwFilterPinnedToggleButton" TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource MaterialDesignSwitchToggleButton}" x:Shared="False">
                <Setter Property="Margin" Value="8" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="IsChecked" Value="{Binding IsPinned}" />
                <Setter Property="ToolTip" Value="Is Pinned" />
                <Setter Property="Content">
                    <Setter.Value>
                        <materialDesign:PackIcon Kind="Pin" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="GwFilterHasMobileToggleButton" TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource MaterialDesignSwitchToggleButton}" x:Shared="False">
                <Setter Property="Margin" Value="8" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="IsChecked" Value="{Binding HasMobile}" />
                <Setter Property="ToolTip" Value="Has Mobile" />
                <Setter Property="Content">
                    <Setter.Value>
                        <materialDesign:PackIcon Kind="Robot" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="GwFilterWordTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource GwTextBox}">
                <Setter Property="Margin" Value="8" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Width" Value="120" />
                <Setter Property="InputMethod.PreferredImeState" Value="On" />
                <Setter Property="InputMethod.PreferredImeConversionMode" Value="FullShape,Native" />
                <Setter Property="materialDesign:TextFieldAssist.HasClearButton" Value="True" />
                <Setter Property="materialDesign:HintAssist.Hint" Value="Free Word" />
                <!--<Setter Property="Text" Value="{Binding Word, UpdateSourceTrigger=PropertyChanged}" />-->
                <Setter Property="Text" Value="{Binding Word}" />
                <Setter Property="assist:TextFieldAssist.IsSelectAllOnGotFocus" Value="True" />
            </Style>

            <Style x:Key="GwFilterHasMemoToggleButton" TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource MaterialDesignSwitchToggleButton}" x:Shared="False">
                <Setter Property="Margin" Value="8" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="IsChecked" Value="{Binding HasMemo}" />
                <Setter Property="ToolTip" Value="Has Memo" />
                <Setter Property="Content">
                    <Setter.Value>
                        <materialDesign:PackIcon Kind="TooltipText" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="GwFilterCategoryComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource GwFilterComboBox}">
                <Setter Property="Width" Value="56" />
                <Setter Property="ItemTemplate" Value="{StaticResource GwRecordIconTextTemplate}" />
                <Setter Property="ItemsSource" Value="{Binding Categories}" />
                <Setter Property="SelectedItem" Value="{Binding Category}" />
                <Setter Property="materialDesign:HintAssist.Hint" Value="For" />
            </Style>

            <Style x:Key="GwFilterTagComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource GwFilterComboBox}">
                <Setter Property="Width" Value="120" />
                <Setter Property="DisplayMemberPath" Value="Name" />
                <Setter Property="ItemsSource" Value="{Binding Tags}" />
                <Setter Property="SelectedItem" Value="{Binding Tag}" />
                <Setter Property="materialDesign:HintAssist.Hint" Value="Tag" />
            </Style>

            <Style x:Key="GwFilterSerialComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource GwFilterComboBox}">
                <Setter Property="Width" Value="300" />
                <Setter Property="DisplayMemberPath" Value="Name" />
                <Setter Property="ItemsSource" Value="{Binding Serials}" />
                <Setter Property="SelectedItem" Value="{Binding Serial}" />
                <Setter Property="materialDesign:HintAssist.Hint" Value="Series" />
            </Style>

            <!--#endregion-->

            <!--#region entry primitive-->

            <Style x:Key="GwEntryToolButton" TargetType="{x:Type Button}" BasedOn="{StaticResource MaterialDesignToolForegroundButton}">
                <Setter Property="FontWeight" Value="Regular" />
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="24" />
            </Style>


