<Application x:Class="Ju.GundamWars.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Ju.GundamWars"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mahApps="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    xmlns:core="clr-namespace:Ju.GundamWars;assembly=Ju.GundamWars.Core"
    xmlns:commons="clr-namespace:Ju.GundamWars.Commons.View"
    xmlns:coMobiles="clr-namespace:Ju.GundamWars.CoMobiles.View"
    xmlns:cuspas="clr-namespace:Ju.GundamWars.Cuspas.View"
    xmlns:pilots="clr-namespace:Ju.GundamWars.Pilots.View"
    xmlns:supports="clr-namespace:Ju.GundamWars.Supports.View"
    Startup="OnStartup"
    Exit="OnExit"
    >
    <Application.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary>
                    <!-- Color -->
                    <!-- RX-93 νガンダム -->
                    <!--白 #ffFAFAF8-->
                    <!--黒 #ff13131F-->
                    <!--黄 #ffF99427-->
                    <!--赤 #ffE7233A-->
                    <Color x:Key="GwBackground2Color">#ff27273f</Color>
                    <Color x:Key="GwPrimaryColor">#ff13131F</Color>
                    <Color x:Key="GwSecondaryColor">#ffF99427</Color>
                    <Color x:Key="GwErrorColor">#ffE7233A</Color>
                    <!-- Brush -->
                    <SolidColorBrush x:Key="GwBackground2Brush" Color="{DynamicResource GwBackground2Color}" />
                    <SolidColorBrush x:Key="GwPrimaryBrush" Color="{DynamicResource GwPrimaryColor}" />
                    <SolidColorBrush x:Key="GwSecondaryBrush" Color="{DynamicResource GwSecondaryColor}" />
                    <SolidColorBrush x:Key="GwValidationErrorBrush" Color="{DynamicResource GwErrorColor}" />
                </ResourceDictionary>
                <!-- Theme -->
                <materialDesign:MahAppsCustomColorTheme BaseTheme="Dark" PrimaryColor="{StaticResource GwPrimaryColor}" SecondaryColor="{StaticResource GwSecondaryColor}" ColorAdjustment="{materialDesign:ColorAdjustment}" />
                <!-- MahApps -->
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Fonts.xaml" />
                <!-- Material Design -->
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Dark.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.ObsoleteBrushes.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.SplitButton.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Toolbar.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
                <!-- Material Design: MahApps Compatibility -->
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.MahApps;component/Themes/MaterialDesignTheme.MahApps.Defaults.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!--<SolidColorBrush x:Key="MaterialDesign.Brush.ToolBar.Background" Color="{DynamicResource GwPrimaryColor}" />-->

            <!-- Converter -->
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource MaterialDesignScrollViewer}" />
            <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource MaterialDesignScrollBarMinimal}" />

            <Style TargetType="{x:Type Hyperlink}" BasedOn="{StaticResource MaterialDesignCaptionHyperlink}">
                <Setter Property="Inline.TextDecorations" Value="Underline" />
            </Style>

            <Style x:Key="GwBorder" TargetType="{x:Type Border}">
                <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="8 0" />
            </Style>

            <Style TargetType="{x:Type ToolBarTray}" BasedOn="{StaticResource MaterialDesignToolBarTray}">
                <Setter Property="IsLocked" Value="True" />
            </Style>

            <Style TargetType="{x:Type ToolBar}" BasedOn="{StaticResource MaterialDesignToolBar}">
                <Style.Resources>
                    <Style TargetType="{x:Type materialDesign:PackIcon}">
                        <Setter Property="FrameworkElement.Width" Value="16" />
                        <Setter Property="FrameworkElement.Height" Value="16" />
                    </Style>
                </Style.Resources>
                <Setter Property="Height" Value="50" />
                <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
            </Style>

            <Style TargetType="{x:Type DataGrid}" BasedOn="{StaticResource MaterialDesignDataGrid}">
                <Setter Property="AutoGenerateColumns" Value="False" />
                <Setter Property="CanUserAddRows" Value="False" />
                <Setter Property="CanUserDeleteRows" Value="False" />
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="GridLinesVisibility" Value="Horizontal" />
                <Setter Property="HeadersVisibility" Value="Column" />
                <Setter Property="SelectionMode" Value="Single" />
                <Setter Property="SelectionUnit" Value="Cell" />
                <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
                <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Standard" />
                <Setter Property="EnableRowVirtualization" Value="True" />
                <!--<Setter Property="Background" Value="{DynamicResource MahApps.Brushes.ThemeBackground}" />-->
            </Style>


            <Style x:Key="GwTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource MaterialDesignTextBox}">
                <Setter Property="Height" Value="30" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="materialDesign:ValidationAssist.Background" Value="Transparent" />
            </Style>

            <DataTemplate x:Key="GwComboBoxGroupHeaderTemplate">
                <TextBlock Padding="8 4" Text="{Binding Name}" Foreground="{DynamicResource PrimaryHueMidBrush}" />
            </DataTemplate>

            <Style x:Key="GwComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource MaterialDesignComboBox}">
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Height" Value="30" />
                <Setter Property="IsSynchronizedWithCurrentItem" Value="False" />
                <Setter Property="materialDesign:ValidationAssist.Background" Value="Transparent" />
            </Style>


            <Style x:Key="GwCancelButton" TargetType="{x:Type Button}" BasedOn="{StaticResource MaterialDesignFlatButton}" x:Shared="False">
                <Setter Property="Width" Value="100" />
                <Setter Property="Height" Value="32" />
                <!--<Setter Property="FontFamily" Value="Yu Gothic UI" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />-->
                <!--<Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />-->
                <!--<Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="0" />-->
                <!--<Setter Property="Command" Value="{Binding CancelCommand}" />-->
                <Setter Property="Content" Value="Cancel" />
                <Setter Property="IsCancel" Value="True" />
            </Style>


            <!-- #region List -->

            <Style x:Key="GwListTextColumn" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Style.Triggers>
                    <Trigger Property="Text" Value="0">
                        <Setter Property="Opacity" Value="0.2" />
                    </Trigger>
                    <Trigger Property="Text" Value="0%">
                        <Setter Property="Opacity" Value="0.2" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="GwListRightTextColumn" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource GwListTextColumn}">
                <Setter Property="HorizontalAlignment" Value="Right" />
            </Style>

            <DataTemplate x:Key="GwListCheckTemplate">
                <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" Content="{Binding Id}" />
            </DataTemplate>

            <DataTemplate x:Key="GwListForUnitTemplate">
                <StackPanel>
                    <materialDesign:PackIcon HorizontalAlignment="Center" Kind="{Binding ForUnitIcon}" />
                    <TextBlock HorizontalAlignment="Center" Text="{Binding ForUnitText}" FontSize="10" />
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="GwListMemoTemplate">
                <Grid x:Name="memo" Width="24" Height="24" Background="Transparent" ToolTip="{Binding Memo}" Visibility="Hidden">
                    <materialDesign:PackIcon HorizontalAlignment="Center" VerticalAlignment="Center" Width="16" Height="16" Kind="TooltipText" />
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding HasMemo}" Value="True">
                        <Setter TargetName="memo" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <DataTemplate x:Key="GwGradeTemplate">
                <TextBlock VerticalAlignment="Center">
                    <Run Text="★" Foreground="{Binding GradeColor}" />
                    <Run Text="{Binding GradeText, Mode=OneWay}" />
                </TextBlock>
            </DataTemplate>

            <Style x:Key="GwListCopyButton" TargetType="{x:Type Button}" BasedOn="{StaticResource MaterialDesignIconForegroundButton}" x:Shared="False">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <!--<Setter Property="Command" Value="{Binding DataContext.OpenEntryAsCopyCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                <Setter Property="CommandParameter" Value="{Binding}" />-->
                <Setter Property="ToolTip" Value="Copy" />
                <Setter Property="Content">
                    <Setter.Value>
                        <materialDesign:PackIcon Width="16" Height="16" Kind="ContentCopy" />
                    </Setter.Value>
                </Setter>
            </Style>


            <!-- #endregion -->

            <!-- #region Filter -->

            <!--<Style x:Key="GwFilterWordTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource GwTextBox}" x:Shared="False">
                <Setter Property="Margin" Value="8" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Width" Value="120" />
                <Setter Property="InputMethod.PreferredImeState" Value="On" />
                <Setter Property="InputMethod.PreferredImeConversionMode" Value="FullShape,Native" />
                <Setter Property="materialDesign:TextFieldAssist.HasClearButton" Value="True" />
                <Setter Property="materialDesign:HintAssist.Hint" Value="フリー ワード" />
                <Setter Property="Text" Value="{Binding WordFilter, UpdateSourceTrigger=PropertyChanged}" />
            </Style>-->


            <Style x:Key="GwFilterComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource GwComboBox}">
                <Setter Property="Margin" Value="8" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="materialDesign:TextFieldAssist.HasClearButton" Value="True" />
            </Style>

            <Style x:Key="GwFilterSerialComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource GwFilterComboBox}" x:Shared="False">
                <Setter Property="Width" Value="300" />
                <Setter Property="DisplayMemberPath" Value="Name" />
                <Setter Property="ItemsSource" Value="{Binding Serials}" />
                <Setter Property="SelectedItem" Value="{Binding SerialFilter}" />
                <Setter Property="materialDesign:HintAssist.Hint" Value="{Binding Source={x:Static core:GwText.Serial}}" />
            </Style>

            <Style x:Key="GwFilterTagComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource GwFilterComboBox}" x:Shared="False">
                <Setter Property="Width" Value="144" />
                <Setter Property="DisplayMemberPath" Value="Name" />
                <Setter Property="ItemsSource" Value="{Binding Tags}" />
                <Setter Property="SelectedItem" Value="{Binding TagFilter}" />
                <Setter Property="materialDesign:HintAssist.Hint" Value="{Binding Source={x:Static core:GwText.Tag}}" />
            </Style>

            <Style x:Key="GwFilterForUnitComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource GwFilterComboBox}" x:Shared="False">
                <Setter Property="Width" Value="88" />
                <Setter Property="ItemsSource" Value="{Binding ForUnits}" />
                <Setter Property="SelectedItem" Value="{Binding ForUnitFilter}" />
                <!--<Setter Property="materialDesign:HintAssist.Hint" Value="{Binding Source={x:Static core:GwText.ForUnit}}" />-->
                <Setter Property="ItemTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" >
                                <materialDesign:PackIcon Margin="0 0 8 0" VerticalAlignment="Center" Kind="{Binding Icon}" />
                                <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                            </StackPanel>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="GwFilterCuspaKindComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource GwFilterComboBox}" x:Shared="False">
                <Setter Property="Width" Value="96" />
                <Setter Property="DisplayMemberPath" Value="Name" />
                <Setter Property="ItemsSource" Value="{Binding CuspaKinds}" />
                <Setter Property="SelectedItem" Value="{Binding CuspaKindFilter}" />
                <!--<Setter Property="materialDesign:HintAssist.Hint" Value="{Binding Source={x:Static core:GwText.CuspaKind}}" />-->
            </Style>

            <Style x:Key="GwFilterBoostStatusComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource GwFilterComboBox}" x:Shared="False">
                <Setter Property="Width" Value="144" />
                <Setter Property="DisplayMemberPath" Value="Name" />
                <Setter Property="ItemsSource" Value="{Binding BoostStatuses}" />
                <Setter Property="SelectedItem" Value="{Binding BoostStatusFilter}" />
                <!--<Setter Property="materialDesign:HintAssist.Hint" Value="{Binding Source={x:Static core:GwText.BoostStatus}}" />-->
            </Style>


            <Style x:Key="GwFilterToggleButton" TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource MaterialDesignSwitchToggleButton}">
                <Setter Property="Margin" Value="8" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="GwFilterHasMemoToggleButton" TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource GwFilterToggleButton}" x:Shared="False">
                <Setter Property="IsChecked" Value="{Binding HasMemoFilter}" />
                <Setter Property="ToolTip" Value="メモあり" />
                <Setter Property="Content">
                    <Setter.Value>
                        <materialDesign:PackIcon Kind="TooltipTextOutline" />
                    </Setter.Value>
                </Setter>
                <Setter Property="materialDesign:ToggleButtonAssist.OnContent">
                    <Setter.Value>
                        <materialDesign:PackIcon Kind="TooltipText" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="GwFilterHasNoMobileToggleButton" TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource GwFilterToggleButton}" x:Shared="False">
                <Setter Property="IsChecked" Value="{Binding HasNoMobileFilter}" />
                <Setter Property="ToolTip" Value="機体未設定" />
                <Setter Property="Content">
                    <Setter.Value>
                        <materialDesign:PackIcon Kind="RobotOffOutline" />
                    </Setter.Value>
                </Setter>
                <Setter Property="materialDesign:ToggleButtonAssist.OnContent">
                    <Setter.Value>
                        <materialDesign:PackIcon Kind="RobotOff" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="GwFilterIsNotPinnedToggleButton" TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource GwFilterToggleButton}" x:Shared="False">
                <Setter Property="IsChecked" Value="{Binding IsNotPinnedFilter}" />
                <Setter Property="ToolTip" Value="ピン止め" />
                <Setter Property="Content">
                    <Setter.Value>
                        <materialDesign:PackIcon Kind="PinOutline" />
                    </Setter.Value>
                </Setter>
                <Setter Property="materialDesign:ToggleButtonAssist.OnContent">
                    <Setter.Value>
                        <materialDesign:PackIcon Kind="Pin" />
                    </Setter.Value>
                </Setter>
            </Style>


            <RelativeSource x:Key="GwCoMobileListRelativeSource" AncestorType="{x:Type coMobiles:CoMobileView}" />


            <RelativeSource x:Key="GwCuspaListRelativeSource" AncestorType="{x:Type cuspas:CuspaView}" />


            <RelativeSource x:Key="GwPilotListRelativeSource" AncestorType="{x:Type pilots:PilotView}" />

            <Style x:Key="GwFilterPilotAbilityComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource GwFilterComboBox}">
                <Setter Property="Width" Value="224" />
                <Setter Property="DisplayMemberPath" Value="Name" />
                <Setter Property="ItemsSource" Value="{Binding PilotAbilities}" />
                <Setter Property="SelectedItem" Value="{Binding PilotAbilityFilter}" />
                <Setter Property="materialDesign:HintAssist.Hint" Value="アビリティ" />
            </Style>

            <Style x:Key="GwFilterPilotSkillComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource GwFilterComboBox}">
                <Setter Property="Width" Value="224" />
                <Setter Property="DisplayMemberPath" Value="Name" />
                <Setter Property="ItemsSource" Value="{Binding PilotSkills}" />
                <Setter Property="SelectedItem" Value="{Binding PilotSkillFilter}" />
                <Setter Property="materialDesign:HintAssist.Hint" Value="スキル" />
            </Style>


            <RelativeSource x:Key="GwSupportListRelativeSource" AncestorType="{x:Type supports:SupportView}" />

            <Style x:Key="GwFilterSupportBadgeComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource GwFilterComboBox}">
                <Setter Property="Width" Value="220" />
                <Setter Property="DisplayMemberPath" Value="Name" />
                <Setter Property="ItemsSource" Value="{Binding SupportBadges}" />
                <Setter Property="SelectedItem" Value="{Binding SupportBadgeFilter}" />
                <Setter Property="materialDesign:HintAssist.Hint" Value="バッジ" />
            </Style>

            <Style x:Key="GwFilterSupportSlotComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource GwFilterComboBox}">
                <Setter Property="Width" Value="224" />
                <Setter Property="DisplayMemberPath" Value="Name" />
                <Setter Property="ItemsSource" Value="{Binding SupportSlots}" />
                <Setter Property="SelectedItem" Value="{Binding SupportSlotFilter}" />
                <Setter Property="materialDesign:HintAssist.Hint" Value="スロット" />
            </Style>

            <!--<Style x:Key="GwFilterUnlockSlotComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource GwFilterComboBox}">
                <Setter Property="Width" Value="224" />
                <Setter Property="DisplayMemberPath" Value="Name" />
                <Setter Property="ItemsSource" Value="{Binding UnlockSlots}" />
                <Setter Property="SelectedItem" Value="{Binding UnlockSlotFilter}" />
                <Setter Property="materialDesign:HintAssist.Hint" Value="Unlock Slot" />
            </Style>

            <Style x:Key="GwFilterBonusSlotComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource GwFilterComboBox}">
                <Setter Property="Width" Value="224" />
                <Setter Property="DisplayMemberPath" Value="Name" />
                <Setter Property="ItemsSource" Value="{Binding BonusSlots}" />
                <Setter Property="SelectedItem" Value="{Binding BonusSlotFilter}" />
                <Setter Property="materialDesign:HintAssist.Hint" Value="Bonus Slot" />
            </Style>-->

            <!-- #endregion -->

        </ResourceDictionary>
    </Application.Resources>
</Application>
