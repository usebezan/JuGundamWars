                            <TextBlock Margin="8 0 0 0" VerticalAlignment="Center" Text="{Binding Proof, StringFormat={}Proof: {0}}" ToolTip="★1: 1&#10;★2: 2&#10;★3: 4&#10;★4: 7&#10;★5: 11" />
