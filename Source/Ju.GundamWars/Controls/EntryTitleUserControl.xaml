<UserControl x:Class="Ju.GundamWars.Controls.EntryTitleUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:root="clr-namespace:Ju.GundamWars"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance root:EntryViewModelBase`3}"
    SnapsToDevicePixels="True"
    >
    <DockPanel>
        <Button DockPanel.Dock="Left" Style="{StaticResource GwBackButton}" Margin="0 0 16 0" />
        <materialDesign:PackIcon DockPanel.Dock="Left" Margin="0 0 8 0" VerticalAlignment="Center" Width="24" Height="24" Kind="{Binding Icon}" />
        <TextBlock Style="{StaticResource MaterialDesignHeadline6TextBlock}" VerticalAlignment="Center" FontWeight="Regular">
            <Run Text="{Binding Text, Mode=OneWay}" />
            <Run Text="Entry" />
        </TextBlock>
    </DockPanel>
</UserControl>
