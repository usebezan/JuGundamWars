<UserControl x:Class="Ju.GundamWars.Pilots.PilotSelectionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ctrl="clr-namespace:Ju.GundamWars.Controls"
    xmlns:local="clr-namespace:Ju.GundamWars.Pilots"
    xmlns:const="clr-namespace:Ju.GundamWars.Const;assembly=Ju.GundamWars.Core"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance local:PilotSelectionViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    SnapsToDevicePixels="True"
    >
    <DockPanel>
        <ctrl:SelectionTitleUserControl DockPanel.Dock="Top" Margin="16" />
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Command="{Binding ClearCommand}" Content="{materialDesign:PackIcon FilterRemoveOutline}" ToolTip="Clear filter" />
                <TextBox Style="{StaticResource GwFilterWordTextBox}" />
                <ComboBox Style="{StaticResource GwFilterTagComboBox}" />
                <ToggleButton Style="{StaticResource GwFilterHasMemoToggleButton}" />
                <ComboBox Style="{StaticResource GwFilterPilotAbilityComboBox}">
                    <ComboBox.GroupStyle>
                        <GroupStyle HeaderTemplate="{StaticResource GwComboBoxGroupHeaderTemplate}" />
                    </ComboBox.GroupStyle>
                </ComboBox>
                <ComboBox Style="{StaticResource GwFilterPilotSkillComboBox}">
                    <ComboBox.GroupStyle>
                        <GroupStyle HeaderTemplate="{StaticResource GwComboBoxGroupHeaderTemplate}" />
                    </ComboBox.GroupStyle>
                </ComboBox>
                <ComboBox Style="{StaticResource GwFilterSerialComboBox}" />
            </ToolBar>
        </ToolBarTray>
        <DataGrid FrozenColumnCount="2">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Name"
                    CellTemplate="{StaticResource GwSelectionDataGridNameTemplate}"
                    SortMemberPath="Name"
                    SortDirection="Ascending"
                />
                <DataGridTextColumn Header="Skill"
                    ElementStyle="{StaticResource GwListTextColumn}"
                    Binding="{Binding Skill.Name}"
                />

                <DataGridTextColumn Header="Mobile"
                    ElementStyle="{StaticResource GwListTextColumn}"
                    Binding="{Binding Mobile.Name}"
                    Width="120"
                />

                <DataGridTextColumn Header="{Binding Source={x:Static const:GwText.Shooting}}"
                    ElementStyle="{StaticResource GwListRightTextColumn}"
                    Binding="{Binding ActualStatus.Shooting, StringFormat={}{0:N0}}"
                />
                <DataGridTextColumn Header="{Binding Source={x:Static const:GwText.Melee}}"
                    ElementStyle="{StaticResource GwListRightTextColumn}"
                    Binding="{Binding ActualStatus.Melee, StringFormat={}{0:N0}}"
                />
                <DataGridTextColumn Header="{Binding Source={x:Static const:GwText.Accuracy}}"
                    ElementStyle="{StaticResource GwListRightTextColumn}"
                    Binding="{Binding ActualStatus.Accuracy, StringFormat={}{0:N0}}"
                />
                <DataGridTextColumn Header="{Binding Source={x:Static const:GwText.Evasion}}"
                    ElementStyle="{StaticResource GwListRightTextColumn}"
                    Binding="{Binding ActualStatus.Evasion, StringFormat={}{0:N0}}"
                />
                <DataGridTextColumn Header="{Binding Source={x:Static const:GwText.Awakened}}"
                    ElementStyle="{StaticResource GwListRightTextColumn}"
                    Binding="{Binding ActualStatus.Awakened, StringFormat={}{0:N0}}"
                />
                <DataGridTextColumn Header="{Binding Source={x:Static const:GwText.Defense}}"
                    ElementStyle="{StaticResource GwListRightTextColumn}"
                    Binding="{Binding ActualStatus.Defense, StringFormat={}{0:N0}}"
                />

                <DataGridTextColumn Header="Practiced&#x0a;Total"
                    ElementStyle="{StaticResource GwListRightTextColumn}"
                    Binding="{Binding PracticedStatusTotal, StringFormat={}{0:N0}}"
                />

                <DataGridTextColumn Header="Slot 1"
                    ElementStyle="{StaticResource GwListRightTextColumn}"
                    Binding="{Binding SlotRank1}"
                />
                <DataGridTextColumn Header="Ability 1"
                    ElementStyle="{StaticResource GwListTextColumn}"
                    Binding="{Binding Ability1.Name}"
                />
                <DataGridTextColumn Header="Slot 2"
                    ElementStyle="{StaticResource GwListRightTextColumn}"
                    Binding="{Binding SlotRank2}"
                />
                <DataGridTextColumn Header="Ability 2"
                    ElementStyle="{StaticResource GwListTextColumn}"
                    Binding="{Binding Ability2.Name}"
                />
                <DataGridTextColumn Header="Slot 3"
                    ElementStyle="{StaticResource GwListRightTextColumn}"
                    Binding="{Binding SlotRank3}"
                />
                <DataGridTextColumn Header="Ability 3"
                    ElementStyle="{StaticResource GwListTextColumn}"
                    Binding="{Binding Ability3.Name}"
                />

                <DataGridTemplateColumn Header="Grade"
                    CellTemplate="{StaticResource GwGradeTemplate}"
                    SortMemberPath="Grade.Value"
                />
                <DataGridTextColumn Header="Level"
                    ElementStyle="{StaticResource GwListRightTextColumn}"
                    Binding="{Binding Level}"
                />
                <DataGridTextColumn Header="Skill Text1"
                    ElementStyle="{StaticResource GwListTextColumn}"
                    Binding="{Binding SkillText1}"
                />
                <DataGridTextColumn Header="Skill Text2"
                    ElementStyle="{StaticResource GwListTextColumn}"
                    Binding="{Binding SkillText2}"
                />
                <DataGridTextColumn Header="Series"
                    ElementStyle="{StaticResource GwListTextColumn}"
                    Binding="{Binding Serial.Name}"
                    SortMemberPath="Serial.Order"
                />
                <DataGridTextColumn Header="Tags"
                    ElementStyle="{StaticResource GwListTextColumn}"
                    Binding="{Binding TagsText}"
                />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
