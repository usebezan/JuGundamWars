<UserControl x:Class="Ju.GundamWars.Pilots.View.PilotDataGridView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mahApps="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    xmlns:core="clr-namespace:Ju.GundamWars;assembly=Ju.GundamWars.Core"
    xmlns:commons="clr-namespace:Ju.GundamWars.Commons.View"
    xmlns:pilots="clr-namespace:Ju.GundamWars.Pilots.View"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance pilots:PilotListViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    >
    <UserControl.Resources>
        <DataTemplate x:Key="GwPilotListNameTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center">
                        <Hyperlink
                            Command="{Binding DataContext.OpenEntryAsEditCommand, RelativeSource={StaticResource GwPilotListRelativeSource}}"
                            CommandParameter="{Binding}"
                            >
                            <TextBlock Text="{Binding Name}" />
                        </Hyperlink>
                    </TextBlock>
                <materialDesign:PackIcon x:Name="pin" Width="12" VerticalAlignment="Top" Kind="Pin" Visibility="Collapsed" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                    <Setter TargetName="pin" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="GwPilotListNameCellTemplate">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentControl Grid.Column="0" VerticalAlignment="Center" Content="{Binding}" ContentTemplate="{StaticResource GwList.ForUnitTemplate}" />
                <ContentControl Grid.Column="1" Margin="8 0 0 0" Content="{Binding}" ContentTemplate="{StaticResource GwPilotListNameTemplate}" />
                <ContentControl Grid.Column="2" Margin="4 0 0 0" Content="{Binding}" ContentTemplate="{StaticResource GwList.MemoTemplate}" />
                <Button
                    Style="{StaticResource GwList.CopyButton}"
                    Grid.Column="3"
                    Margin="8 0 0 0"
                    Command="{Binding DataContext.OpenEntryAsCopyCommand, RelativeSource={StaticResource GwPilotListRelativeSource}}"
                    CommandParameter="{Binding}"
                />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <DataGrid ItemsSource="{Binding ItemsView}" FrozenColumnCount="3">
            <DataGrid.Columns>
                <DataGridTemplateColumn CellTemplate="{StaticResource GwList.CheckTemplate}" />
                <DataGridTemplateColumn Header="Name"
                    CellTemplate="{StaticResource GwPilotListNameCellTemplate}"
                    SortMemberPath="Name"
                    SortDirection="Ascending"
                />
                <DataGridTextColumn Header="Skill"
                    ElementStyle="{StaticResource GwList.TextColumn}"
                    Binding="{Binding PilotSkill.Name}"
                />
                <!-- TODO: 
                <DataGridTextColumn Header="Mobile"
                    ElementStyle="{StaticResource GwList.TextColumn}"
                    Binding="{Binding Mobile.Name}"
                    Width="120"
                />
                -->
                <DataGridTextColumn Header="{Binding Source={x:Static core:GwText.Shooting}}"
                    ElementStyle="{StaticResource GwList.RightTextColumn}"
                    Binding="{Binding ActualStatus.Shooting, StringFormat={}{0:N0}}"
                />
                <DataGridTextColumn Header="{Binding Source={x:Static core:GwText.Melee}}"
                    ElementStyle="{StaticResource GwList.RightTextColumn}"
                    Binding="{Binding ActualStatus.Melee, StringFormat={}{0:N0}}"
                />
                <DataGridTextColumn Header="{Binding Source={x:Static core:GwText.Accuracy}}"
                    ElementStyle="{StaticResource GwList.RightTextColumn}"
                    Binding="{Binding ActualStatus.Accuracy, StringFormat={}{0:N0}}"
                />
                <DataGridTextColumn Header="{Binding Source={x:Static core:GwText.Evasion}}"
                    ElementStyle="{StaticResource GwList.RightTextColumn}"
                    Binding="{Binding ActualStatus.Evasion, StringFormat={}{0:N0}}"
                />
                <DataGridTextColumn Header="{Binding Source={x:Static core:GwText.Awakened}}"
                    ElementStyle="{StaticResource GwList.RightTextColumn}"
                    Binding="{Binding ActualStatus.Awakened, StringFormat={}{0:N0}}"
                />
                <DataGridTextColumn Header="{Binding Source={x:Static core:GwText.Defense}}"
                    ElementStyle="{StaticResource GwList.RightTextColumn}"
                    Binding="{Binding ActualStatus.Defense, StringFormat={}{0:N0}}"
                />
                <DataGridTextColumn Header="修練値合計"
                    ElementStyle="{StaticResource GwList.RightTextColumn}"
                    Binding="{Binding PracticedStatusTotal, StringFormat={}{0:N0}}"
                />

                <DataGridTextColumn Header="アビリティ&#x0a;スロット1"
                    ElementStyle="{StaticResource GwList.RightTextColumn}"
                    Binding="{Binding PilotSlotAbilities[0].SlotRank}"
                />
                <DataGridTextColumn Header="アビリティ1"
                    ElementStyle="{StaticResource GwList.TextColumn}"
                    Binding="{Binding PilotSlotAbilities[0].PilotAbility.Name}"
                />
                <DataGridTextColumn Header="アビリティ&#x0a;スロット2"
                    ElementStyle="{StaticResource GwList.RightTextColumn}"
                    Binding="{Binding PilotSlotAbilities[1].SlotRank}"
                />
                <DataGridTextColumn Header="アビリティ2"
                    ElementStyle="{StaticResource GwList.TextColumn}"
                    Binding="{Binding PilotSlotAbilities[1].PilotAbility.Name}"
                />
                <DataGridTextColumn Header="アビリティ&#x0a;スロット3"
                    ElementStyle="{StaticResource GwList.RightTextColumn}"
                    Binding="{Binding PilotSlotAbilities[2].SlotRank}"
                />
                <DataGridTextColumn Header="アビリティ3"
                    ElementStyle="{StaticResource GwList.TextColumn}"
                    Binding="{Binding PilotSlotAbilities[2].PilotAbility.Name}"
                />

                <DataGridTemplateColumn Header="{Binding Source={x:Static core:GwText.Grade}}"
                    CellTemplate="{StaticResource Gw.GradeTemplate}"
                    SortMemberPath="Grade.Value"
                />
                <DataGridTextColumn Header="{Binding Source={x:Static core:GwText.Level}}"
                    ElementStyle="{StaticResource GwList.RightTextColumn}"
                    Binding="{Binding Level}"
                />
                <DataGridTextColumn Header="スキル説明1"
                    ElementStyle="{StaticResource GwList.TextColumn}"
                    Binding="{Binding PilotSkillText1}"
                />
                <DataGridTextColumn Header="スキル説明2"
                    ElementStyle="{StaticResource GwList.TextColumn}"
                    Binding="{Binding PilotSkillText2}"
                />
                <DataGridTextColumn Header="{Binding Source={x:Static core:GwText.Serial}}"
                    ElementStyle="{StaticResource GwList.TextColumn}"
                    Binding="{Binding Serial.Name}"
                    SortMemberPath="Serial.Order"
                />
                <DataGridTextColumn Header="{Binding Source={x:Static core:GwText.Tag}}"
                    ElementStyle="{StaticResource GwList.TextColumn}"
                    Binding="{Binding TagsText}"
                />
            </DataGrid.Columns>
        </DataGrid>
        <materialDesign:PopupBox Margin="16" HorizontalAlignment="Left" VerticalAlignment="Top">
            <StackPanel>
                <Button
                    Command="{Binding DataContext.CheckAllCommand, RelativeSource={StaticResource GwPilotListRelativeSource}}"
                    Content="Check all"
                />
                <Button
                    Command="{Binding DataContext.UncheckAllCommand, RelativeSource={StaticResource GwPilotListRelativeSource}}"
                    Content="Uncheck all"
                />
            </StackPanel>
        </materialDesign:PopupBox>
    </Grid>
</UserControl>
