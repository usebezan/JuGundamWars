<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options" 
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:core="clr-namespace:Ju.GundamWars;assembly=Ju.GundamWars.Core"
	>

    <Style x:Key="GwFilter.CuspaKindComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource GwFilter.ComboBox}">
        <Setter Property="Width" Value="96" />
        <Setter Property="DisplayMemberPath" Value="Name" />
        <Setter Property="ItemsSource" Value="{Binding CuspaKinds}" />
        <Setter Property="SelectedItem" Value="{Binding CuspaKindFilter}" />
        <!-- TODO: <Setter Property="materialDesign:HintAssist.Hint" Value="{Binding Source={x:Static core:GwText.CuspaKind}}" />-->
    </Style>

</ResourceDictionary>
