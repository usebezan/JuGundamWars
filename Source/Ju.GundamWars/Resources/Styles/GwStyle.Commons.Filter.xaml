    <!-- #endregion -->

    <!-- #region ComboBox -->

    <Style x:Key="GwFilter.ComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource Gw.ComboBox}">
        <Setter Property="Margin" Value="8" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="materialDesign:TextFieldAssist.HasClearButton" Value="True" />
    </Style>


    <Style x:Key="GwFilter.BoostStatusComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource GwFilter.ComboBox}">
        <Setter Property="Width" Value="144" />
        <Setter Property="DisplayMemberPath" Value="Name" />
        <Setter Property="ItemsSource" Value="{Binding BoostStatuses}" />
        <Setter Property="SelectedItem" Value="{Binding BoostStatusFilter}" />
        <!-- TODO: <Setter Property="materialDesign:HintAssist.Hint" Value="{Binding Source={x:Static core:GwText.BoostStatus}}" />-->
    </Style>

    <Style x:Key="GwFilter.ForUnitComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource GwFilter.ComboBox}" x:Shared="False">
        <Setter Property="Width" Value="88" />
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" >
                        <materialDesign:PackIcon Margin="0 0 8 0" VerticalAlignment="Center" Kind="{Binding Icon}" />
                        <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsSource" Value="{Binding ForUnits}" />
        <Setter Property="SelectedItem" Value="{Binding ForUnitFilter}" />
        <!-- TODO: <Setter Property="materialDesign:HintAssist.Hint" Value="{Binding Source={x:Static core:GwText.ForUnit}}" />-->
    </Style>

    <Style x:Key="GwFilter.RoleComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource GwFilter.ComboBox}" x:Shared="False">
        <Setter Property="Width" Value="80" />
        <Setter Property="DisplayMemberPath" Value="Name" />
        <Setter Property="ItemsSource" Value="{Binding Roles}" />
        <Setter Property="SelectedItem" Value="{Binding RoleFilter}" />
        <Setter Property="materialDesign:HintAssist.Hint" Value="{Binding Source={x:Static core:GwText.Role}}" />
    </Style>

    <Style x:Key="GwFilter.SerialComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource GwFilter.ComboBox}" x:Shared="False">
        <Setter Property="Width" Value="300" />
        <Setter Property="DisplayMemberPath" Value="Name" />
        <Setter Property="ItemsSource" Value="{Binding Serials}" />
        <Setter Property="SelectedItem" Value="{Binding SerialFilter}" />
        <Setter Property="materialDesign:HintAssist.Hint" Value="{Binding Source={x:Static core:GwText.Serial}}" />
    </Style>

    <Style x:Key="GwFilter.TagComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource GwFilter.ComboBox}" x:Shared="False">
        <Setter Property="Width" Value="144" />
        <Setter Property="DisplayMemberPath" Value="Name" />
        <Setter Property="ItemsSource" Value="{Binding Tags}" />
        <Setter Property="SelectedItem" Value="{Binding TagFilter}" />
        <Setter Property="materialDesign:HintAssist.Hint" Value="{Binding Source={x:Static core:GwText.Tag}}" />
    </Style>

    <!-- #endregion -->

    <!-- #region ToggleButton -->

    <Style x:Key="GwFilter.ToggleButton" TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource MaterialDesignSwitchToggleButton}">
        <Setter Property="Margin" Value="8" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>


    <Style x:Key="GwFilter.HasMemoToggleButton" TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource GwFilter.ToggleButton}" x:Shared="False">
        <Setter Property="IsChecked" Value="{Binding HasMemoFilter}" />
        <Setter Property="ToolTip" Value="メモあり" />
        <Setter Property="Content" Value="{materialDesign:PackIcon Kind=TooltipTextOutline}" />
        <Setter Property="materialDesign:ToggleButtonAssist.OnContent" Value="{materialDesign:PackIcon Kind=TooltipText}" />
    </Style>

    <Style x:Key="GwFilter.HasNoMobileToggleButton" TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource GwFilter.ToggleButton}" x:Shared="False">
        <Setter Property="IsChecked" Value="{Binding HasNoMobileFilter}" />
        <Setter Property="ToolTip" Value="機体未設定" />
        <Setter Property="Content" Value="{materialDesign:PackIcon Kind=RobotOffOutline}" />
        <Setter Property="materialDesign:ToggleButtonAssist.OnContent" Value="{materialDesign:PackIcon Kind=RobotOff}" />
    </Style>

    <Style x:Key="GwFilter.IsNotPinnedToggleButton" TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource GwFilter.ToggleButton}" x:Shared="False">
        <Setter Property="IsChecked" Value="{Binding IsNotPinnedFilter}" />
        <Setter Property="ToolTip" Value="ピン止め" />
        <Setter Property="Content" Value="{materialDesign:PackIcon Kind=PinOffOutline}" />
        <Setter Property="materialDesign:ToggleButtonAssist.OnContent" Value="{materialDesign:PackIcon Kind=PinOff}" />
    </Style>

    <!-- #endregion -->

</ResourceDictionary>
