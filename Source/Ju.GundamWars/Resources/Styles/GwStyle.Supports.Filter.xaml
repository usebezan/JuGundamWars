<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options" 
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:core="clr-namespace:Ju.GundamWars;assembly=Ju.GundamWars.Core"
	>

    <Style x:Key="GwFilter.SupportBadgeComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource GwFilter.ComboBox}">
        <Setter Property="Width" Value="220" />
        <Setter Property="DisplayMemberPath" Value="Name" />
        <Setter Property="ItemsSource" Value="{Binding SupportBadges}" />
        <Setter Property="SelectedItem" Value="{Binding SupportBadgeFilter}" />
        <Setter Property="materialDesign:HintAssist.Hint" Value="バッジ" />
    </Style>

    <Style x:Key="GwFilter.SupportSlotComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource GwFilter.ComboBox}">
        <Setter Property="Width" Value="224" />
        <Setter Property="DisplayMemberPath" Value="Name" />
        <Setter Property="ItemsSource" Value="{Binding SupportSlots}" />
        <Setter Property="SelectedItem" Value="{Binding SupportSlotFilter}" />
        <Setter Property="materialDesign:HintAssist.Hint" Value="スロット" />
    </Style>

