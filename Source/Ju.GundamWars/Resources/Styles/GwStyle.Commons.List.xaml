<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options" 
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:core="clr-namespace:Ju.GundamWars;assembly=Ju.GundamWars.Core"
	>

    <Style x:Key="GwList.TextColumn" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="Text" Value="0">
                <Setter Property="Opacity" Value="0.2" />
            </Trigger>
            <Trigger Property="Text" Value="0%">
                <Setter Property="Opacity" Value="0.2" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GwList.RightTextColumn" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource GwList.TextColumn}">
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>


    <DataTemplate x:Key="GwList.CheckTemplate">
        <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" Content="{Binding Id, Mode=OneWay}" />
    </DataTemplate>

    <DataTemplate x:Key="GwList.ForUnitTemplate">
        <StackPanel>
            <materialDesign:PackIcon HorizontalAlignment="Center" Kind="{Binding ForUnitIcon}" />
            <TextBlock HorizontalAlignment="Center" Text="{Binding ForUnitText}" FontSize="10" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="GwList.MemoTemplate">
        <Grid x:Name="memo" Width="24" Height="24" Background="Transparent" ToolTip="{Binding Memo}" Visibility="Hidden">
            <materialDesign:PackIcon HorizontalAlignment="Center" VerticalAlignment="Center" Width="16" Height="16" Kind="TooltipText" />
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding HasMemo}" Value="True">
                <Setter TargetName="memo" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>


    <Style x:Key="GwList.CopyButton" TargetType="{x:Type Button}" BasedOn="{StaticResource MaterialDesignIconForegroundButton}" x:Shared="False">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <!--
        <Setter Property="Command" Value="{Binding DataContext.OpenEntryAsCopyCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
        <Setter Property="CommandParameter" Value="{Binding}" />
        -->
        <Setter Property="ToolTip" Value="Copy" />
        <Setter Property="Content" Value="{materialDesign:PackIcon Kind=ContentCopy,Size=16}" />
    </Style>

</ResourceDictionary>
