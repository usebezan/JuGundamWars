<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options" 
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:core="clr-namespace:Ju.GundamWars;assembly=Ju.GundamWars.Core"
	>

    <!-- #region GroupBox -->

    <Style x:Key="GwEntry.GroupBox" TargetType="{x:Type GroupBox}" BasedOn="{StaticResource MaterialDesignCardGroupBox}">
        <Setter Property="Margin" Value="0 0 0 16" />
        <!--<Setter Property="Padding" Value="8 4" />-->
        <Setter Property="Width" Value="480" />
        <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp0" />
        <Setter Property="materialDesign:ColorZoneAssist.Mode" Value="Custom" />
        <!--<Setter Property="materialDesign:ColorZoneAssist.Foreground" Value="{StaticResource MaterialDesignBody}" />-->
        <!--<Setter Property="materialDesign:ColorZoneAssist.Background" Value="Transparent" />-->
        <!--<Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Grid Height="24">
                            <TextBlock Text="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </Setter.Value>
            </Setter>-->
    </Style>

    <!-- #endregion -->

    <!-- #region Button -->

    <Style x:Key="GwEntry.ToolButton" TargetType="{x:Type Button}" BasedOn="{StaticResource MaterialDesignToolForegroundButton}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MinWidth" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="FontWeight" Value="Regular" />
    </Style>

    <Style x:Key="GwEntry.CancelButton" TargetType="{x:Type Button}" BasedOn="{StaticResource Gw.CancelButtonBase}" x:Shared="False">
        <Setter Property="Command" Value="{Binding CancelCommand, Mode=OneTime}" />
    </Style>

    <Style x:Key="GwEntry.DeleteButton" TargetType="{x:Type Button}" BasedOn="{StaticResource MaterialDesignOutlinedSecondaryButton}" x:Shared="False">
        <Setter Property="Margin" Value="16 0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Width" Value="96" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Content" Value="削除" />
        <Setter Property="Command" Value="{Binding DeleteCommand, Mode=OneTime}" />
        <Setter Property="Visibility" Value="{Binding IsEdit, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </Style>

    <Style x:Key="GwEntry.EnterButton" TargetType="{x:Type Button}" BasedOn="{StaticResource MaterialDesignFlatSecondaryMidBgButton}" x:Shared="False">
        <Setter Property="Margin" Value="16 0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Width" Value="96" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Content" Value="登録" />
        <Setter Property="Command" Value="{Binding EnterCommand, Mode=OneTime}" />
    </Style>

    <!-- #endregion -->

    <!-- #region TextBox -->

    <Style x:Key="GwEntry.TextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource Gw.TextBox}">
        <Setter Property="Margin" Value="8 0 8 8" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="GwEntry.FullTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource GwEntry.TextBox}">
        <Setter Property="InputMethod.PreferredImeState" Value="On" />
        <Setter Property="InputMethod.PreferredImeConversionMode" Value="FullShape,Native" />
    </Style>

    <Style x:Key="GwEntry.RightTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource GwEntry.TextBox}">
        <Setter Property="TextAlignment" Value="Right" />
    </Style>


    <Style x:Key="GwEntry.LevelTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource GwEntry.RightTextBox}">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Width" Value="40" />
        <Setter Property="Text" Value="{Binding Model.Level}" />
    </Style>

    <Style x:Key="GwEntry.MemoTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource GwEntry.FullTextBox}">
        <Setter Property="Height" Value="Auto" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Text" Value="{Binding Model.Memo}" />
    </Style>

    <Style x:Key="GwEntry.StatusTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource GwEntry.RightTextBox}">
        <Setter Property="Width" Value="120" />
    </Style>

    <!-- #endregion -->

    <!-- #region ComboBox -->

    <Style x:Key="GwEntry.ComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource Gw.ComboBox}">
        <Setter Property="Margin" Value="8 0 8 8" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="materialDesign:HintAssist.Hint" Value="Select..." />
    </Style>


    <Style x:Key="GwEntry.SerialComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource GwEntry.ComboBox}">
        <Setter Property="DisplayMemberPath" Value="Name" />
        <Setter Property="ItemsSource" Value="{Binding Serials}" />
        <Setter Property="SelectedItem" Value="{Binding Model.Serial}" />
    </Style>

    <!-- #endregion -->

    <!-- #region ListBox -->

    <Style x:Key="GwEntry.ListBox" TargetType="{x:Type ListBox}" BasedOn="{StaticResource MaterialDesignToolToggleListBox}">
        <Setter Property="Margin" Value="8 0 8 8" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="materialDesign:ListBoxAssist.IsToggle" Value="False" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style x:Key="GwEntry.GradeListBox" TargetType="{x:Type ListBox}" BasedOn="{StaticResource GwEntry.ListBox}">
        <Setter Property="ItemTemplate" Value="{StaticResource Gw.GradeTemplate}" />
        <Setter Property="ItemsSource" Value="{Binding Grades}" />
        <Setter Property="SelectedItem" Value="{Binding Model.Grade}" />
    </Style>

    <Style x:Key="GwEntry.RoleListBox" TargetType="{x:Type ListBox}" BasedOn="{StaticResource GwEntry.ListBox}">
        <Setter Property="DisplayMemberPath" Value="Name" />
        <Setter Property="ItemsSource" Value="{Binding Roles}" />
        <Setter Property="SelectedItem" Value="{Binding Model.Role}" />
    </Style>

    <Style x:Key="GwEntry.TagListBoxItem" TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource MaterialDesignFilterChipOutlineListBoxItem}">
        <Setter Property="IsSelected" Value="{Binding IsChecked}"/>
    </Style>

    <Style x:Key="GwEntry.TagListBox" TargetType="{x:Type ListBox}" BasedOn="{StaticResource MaterialDesignFilterChipOutlineListBox}">
        <Setter Property="ItemContainerStyle" Value="{StaticResource GwEntry.TagListBoxItem}" />
        <Setter Property="DisplayMemberPath" Value="Name" />
        <Setter Property="ItemsSource" Value="{Binding Tags}" />
        <!--<Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBox}">
                    <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>-->
    </Style>

    <!-- #endregion -->

</ResourceDictionary>
