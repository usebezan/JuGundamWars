<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options" 
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:core="clr-namespace:Ju.GundamWars;assembly=Ju.GundamWars.Core"
	>

    <Style x:Key="GwFilter.PilotAbilityComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource GwFilter.ComboBox}">
        <Setter Property="Width" Value="224" />
        <Setter Property="DisplayMemberPath" Value="Name" />
        <Setter Property="ItemsSource" Value="{Binding PilotAbilities}" />
        <Setter Property="SelectedItem" Value="{Binding PilotAbilityFilter}" />
        <Setter Property="materialDesign:HintAssist.Hint" Value="アビリティ" />
    </Style>

    <Style x:Key="GwFilter.PilotSkillComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource GwFilter.ComboBox}">
        <Setter Property="Width" Value="224" />
        <Setter Property="DisplayMemberPath" Value="Name" />
        <Setter Property="ItemsSource" Value="{Binding PilotSkills}" />
        <Setter Property="SelectedItem" Value="{Binding PilotSkillFilter}" />
        <Setter Property="materialDesign:HintAssist.Hint" Value="スキル" />
    </Style>

</ResourceDictionary>
