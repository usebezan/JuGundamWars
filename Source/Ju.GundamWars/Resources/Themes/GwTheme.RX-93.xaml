<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options" 
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:core="clr-namespace:Ju.GundamWars;assembly=Ju.GundamWars.Core"
	>
    <!--https://honstock.net/color-pattern-gundam-cca-->
    <!--白 #ffFAFAF8-->
    <!--黒 #ff13131F-->
    <!--黄 #ffF99427-->
    <!--赤 #ffE7233A-->

    <!-- Color -->
    <Color x:Key="GwPrimaryColor">#ff13131F</Color>
    <Color x:Key="GwSecondaryColor">#ffF99427</Color>
    <Color x:Key="GwErrorColor">#ffE7233A</Color>

    <!-- Brush -->
    <SolidColorBrush x:Key="GwPrimaryBrush" Color="{StaticResource GwPrimaryColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="GwSecondaryBrush" Color="{StaticResource GwSecondaryColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="GwValidationErrorBrush" Color="{StaticResource GwErrorColor}" po:Freeze="True" />

    <Color x:Key="GwCheckedBackgroundColor">#ff27273f</Color>
    <SolidColorBrush x:Key="GwCheckedBackgroundBrush" Color="{StaticResource GwCheckedBackgroundColor}" po:Freeze="True" />

</ResourceDictionary>
