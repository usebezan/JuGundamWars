<mahApps:MetroWindow x:Class="Ju.GundamWars.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mahApps="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:Ju.GundamWars"
    xmlns:commons="clr-namespace:Ju.GundamWars.Commons.View"
    xmlns:systems="clr-namespace:Ju.GundamWars.Systems.View"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance local:MainViewModel}"
    FontFamily="Yu Gothic UI"
    Title="J.U Gundam Wars"
    TitleAlignment="Center"
    Height="600"
    Width="1000"
    BorderThickness="0"
    SaveWindowPosition="True"
    SnapsToDevicePixels="True"
    TitleForeground="{DynamicResource GwForegroundBrush}"
    WindowTitleBrush="{DynamicResource GwPrimaryBrush}"
    NonActiveWindowTitleBrush="{DynamicResource GwPrimaryBrush}"
    >
    <mahApps:MetroWindow.Resources>
        <Style x:Key="MenuItemContainer" TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource MaterialDesign3.NavigationRailPrimaryListBoxItem}">
            <Setter Property="materialDesign:NavigationRailAssist.SelectedIcon" Value="{Binding Icon}" />
            <Setter Property="materialDesign:NavigationRailAssist.UnselectedIcon" Value="{Binding Icon}" />
        </Style>
        <Style x:Key="MenuListBox" TargetType="{x:Type ListBox}" BasedOn="{StaticResource MaterialDesignListBox}">
            <Style.Resources>
                <DataTemplate DataType="{x:Type commons:IMenuItemViewModel}">
                    <TextBlock Text="{Binding Text}" TextAlignment="Center" TextWrapping="Wrap" />
                </DataTemplate>
            </Style.Resources>
            <Setter Property="SelectedValue" Value="{Binding SelectedMenu}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource MenuItemContainer}" />
        </Style>
    </mahApps:MetroWindow.Resources>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="ContentRendered">
            <i:InvokeCommandAction Command="{Binding LoadCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <mahApps:MetroWindow.LeftWindowCommands>
        <mahApps:WindowCommands>
            <Button Command="{Binding LoadCommand}" ToolTip="Reload" Content="{materialDesign:PackIcon Refresh}" />
        </mahApps:WindowCommands>
    </mahApps:MetroWindow.LeftWindowCommands>
    <mahApps:MetroWindow.RightWindowCommands>
        <mahApps:WindowCommands>
            <Button Command="{Binding VisitGitHubCommand}" ToolTip="Visit GitHub" Content="{materialDesign:PackIcon Github}" />
        </mahApps:WindowCommands>
    </mahApps:MetroWindow.RightWindowCommands>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <materialDesign:DialogHost Grid.Row="0" Identifier="DialogHost" CloseOnClickAway="False" IsOpen="{Binding ViewState.IsDialogOpen}" DialogContent="{Binding ViewState.DialogContent}">
            <materialDesign:DialogHost.DialogContentTemplate>
                <DataTemplate DataType="{x:Type systems:LoadAllProgressViewModel}">
                    <systems:LoadAllProgressView />
                </DataTemplate>
            </materialDesign:DialogHost.DialogContentTemplate>
            <materialDesign:Transitioner SelectedIndex="{Binding ViewState.SlideIndex, Mode=OneWay}">
                <!-- 0:Main -->
                <materialDesign:TransitionerSlide>
                    <materialDesign:TransitionerSlide.BackwardWipe>
                        <materialDesign:SlideWipe Direction="Left" />
                    </materialDesign:TransitionerSlide.BackwardWipe>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ListBox
                            Grid.Column="0"
                            Style="{StaticResource MenuListBox}"
                            ItemsSource="{Binding MainMenus}"
                        />
                        <Grid Grid.Column="1" />
                    </Grid>
                </materialDesign:TransitionerSlide>
            </materialDesign:Transitioner>
        </materialDesign:DialogHost>
        <materialDesign:Snackbar Grid.Row="1" HorizontalAlignment="Stretch" MessageQueue="{Binding ViewState.SnackbarMessageQueue}" />
    </Grid>
</mahApps:MetroWindow>
