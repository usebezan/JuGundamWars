<mahApps:MetroWindow x:Class="Ju.GundamWars.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mahApps="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:Ju.GundamWars"
    xmlns:systems="clr-namespace:Ju.GundamWars.Systems.View"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance local:MainViewModel}"
    FontFamily="Yu Gothic UI"
    Title="J.U Gundam Wars"
    TitleAlignment="Center"
    Height="600"
    Width="1000"
    BorderThickness="0"
    SaveWindowPosition="True"
    SnapsToDevicePixels="True"
    Background="{DynamicResource GwGwBackgroundBrush}"
    WindowTitleBrush="{DynamicResource GwGwBackgroundBrush}"
    NonActiveWindowTitleBrush="{DynamicResource GwGwBackgroundBrush}"
    >
    <mahApps:MetroWindow.Resources>
        <Style x:Key="GwMenuItemContainer" TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource MaterialDesign3.NavigationRailPrimaryListBoxItem}">
            <Setter Property="materialDesign:NavigationRailAssist.SelectedIcon" Value="{Binding Icon}" />
            <Setter Property="materialDesign:NavigationRailAssist.UnselectedIcon" Value="{Binding Icon}" />
        </Style>
        <Style x:Key="GwMenuListBox" TargetType="{x:Type ListBox}" BasedOn="{StaticResource MaterialDesignListBox}">
            <Style.Resources>
                <DataTemplate DataType="{x:Type systems:MenuItemViewModel}">
                    <TextBlock Text="{Binding Text}" TextAlignment="Center" TextWrapping="Wrap" />
                </DataTemplate>
            </Style.Resources>
            <Setter Property="SelectedValue" Value="{Binding SelectedMenu}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource GwMenuItemContainer}" />
        </Style>
    </mahApps:MetroWindow.Resources>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="ContentRendered">
            <i:InvokeCommandAction Command="{Binding LoadCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <mahApps:MetroWindow.LeftWindowCommands>
        <mahApps:WindowCommands ShowSeparators="False">
            <Button Command="{Binding ReloadCommand}" ToolTip="Reload" Content="{materialDesign:PackIcon Refresh}" />
        </mahApps:WindowCommands>
    </mahApps:MetroWindow.LeftWindowCommands>
    <mahApps:MetroWindow.RightWindowCommands>
        <mahApps:WindowCommands>
            <Button Command="{Binding VisitGitHubCommand}" ToolTip="Visit GitHub" Content="{materialDesign:PackIcon Github}" />
        </mahApps:WindowCommands>
    </mahApps:MetroWindow.RightWindowCommands>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <materialDesign:DialogHost Grid.Row="0" Identifier="DialogHost" CloseOnClickAway="False" IsOpen="{Binding ViewState.IsDialogOpen}" DialogContent="{Binding ViewState.DialogContent}">
            <materialDesign:DialogHost.DialogContentTemplate>
                <DataTemplate DataType="{x:Type systems:LoadAllProgressViewModel}">
                    <systems:LoadAllProgressView />
                </DataTemplate>
            </materialDesign:DialogHost.DialogContentTemplate>
            <materialDesign:Transitioner SelectedIndex="{Binding ViewState.SlideIndex, Mode=OneWay}">
                <!-- 0:Main -->
                <materialDesign:TransitionerSlide>
                    <materialDesign:TransitionerSlide.BackwardWipe>
                        <materialDesign:SlideWipe Direction="Left" />
                    </materialDesign:TransitionerSlide.BackwardWipe>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0 0 0 0">
                            <ListBox Style="{StaticResource GwMenuListBox}" ItemsSource="{Binding Menus}" />
                        </Border>
                        <Border Grid.Column="1" Background="{DynamicResource MaterialDesignPaper}" CornerRadius="8 0 0 0">

                            <StackPanel>
                                <TextBox Margin="20" Width="100" Height="40" Text="Text" />
                                <Button Margin="20" Width="100" Height="40" Content="Text" />
                                <ToggleButton Margin="20" />
                            </StackPanel>

                        </Border>
                    </Grid>
                </materialDesign:TransitionerSlide>
            </materialDesign:Transitioner>
        </materialDesign:DialogHost>
        <materialDesign:Snackbar Grid.Row="1" HorizontalAlignment="Stretch" MessageQueue="{Binding ViewState.SnackbarMessageQueue}" />
    </Grid>
</mahApps:MetroWindow>
