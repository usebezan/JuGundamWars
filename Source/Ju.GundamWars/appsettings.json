{
  "NLog": {
    "throwConfigExceptions": true,
    "targets": {
      "logfile": {
        "type": "File",
        "fileName": ".\\${shortdate}.log"
      }
    },
    "rules": [
      {
        "logger": "*",
        "minLevel": "Debug",
        "writeTo": "logfile"
      }
    ]
  },
  "System": {
    "GitHubUri": "https://github.com/usebezan/",
    "MasterDbVersionUri": "https://raw.githubusercontent.com/usebezan/JuGundamWarsData/main/MasterData.ver",
    "MasterDbFileUri": "https://raw.githubusercontent.com/usebezan/JuGundamWarsData/main/MasterData.db"
  }
}
