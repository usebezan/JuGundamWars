<UserControl x:Class="Ju.GundamWars.Supports.View.SupportListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mahApps="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    xmlns:core="clr-namespace:Ju.GundamWars;assembly=Ju.GundamWars.Core"
    xmlns:commons="clr-namespace:Ju.GundamWars.Commons.View"
    xmlns:supports="clr-namespace:Ju.GundamWars.Supports.View"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance supports:SupportListViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    >
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <materialDesign:SplitButton
                    Style="{StaticResource MaterialDesignFlatSplitButton}"
                    Command="{Binding DataContext.OpenEntryAsNewCommand, RelativeSource={RelativeSource AncestorType={x:Type supports:SupportView}}}"
                    PopupPlacementMode="BottomAndAlignRightEdges"
                    >
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon VerticalAlignment="Center" Margin="0 0 8 0" Kind="PlusBoxOutline" />
                        <TextBlock VerticalAlignment="Center" Text="New" />
                    </StackPanel>
                    <materialDesign:SplitButton.PopupContent>
                        <StackPanel>
                            <Button
                                Command="{Binding DataContext.OpenEntryAsNewCommand, RelativeSource={RelativeSource AncestorType={x:Type supports:SupportView}}}"
                                >
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon VerticalAlignment="Center" Margin="0 0 8 0" Kind="{Binding Source={x:Static core:GwIcon.MobileSuit}}" />
                                    <TextBlock VerticalAlignment="Center" Text="{Binding Source={x:Static core:GwText.MobileSuit}}" />
                                </StackPanel>
                            </Button>
                            <Button
                                Command="{Binding DataContext.OpenEntryAsNewForMaCommand, RelativeSource={RelativeSource AncestorType={x:Type supports:SupportView}}}"
                                >
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon VerticalAlignment="Center" Margin="0 0 8 0" Kind="{Binding Source={x:Static core:GwIcon.MobileArmor}}" />
                                    <TextBlock VerticalAlignment="Center" Text="{Binding Source={x:Static core:GwText.MobileArmor}}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </materialDesign:SplitButton.PopupContent>
                </materialDesign:SplitButton>
                <Separator Margin="4" />
                <Button
                    Command="{Binding DataContext.ClearFilterCommand, RelativeSource={RelativeSource AncestorType={x:Type supports:SupportView}}}"
                    Content="{materialDesign:PackIcon FilterRemoveOutline}"
                    ToolTip="フィルター解除"
                />
                <ComboBox Style="{StaticResource GwFilterForUnitComboBox}" />
                <ComboBox Style="{StaticResource GwFilterTagComboBox}" />
                <ComboBox Style="{StaticResource GwFilterSupportBadgeComboBox}">
                    <ComboBox.GroupStyle>
                        <GroupStyle HeaderTemplate="{StaticResource GwComboBoxGroupHeaderTemplate}" />
                    </ComboBox.GroupStyle>
                </ComboBox>
                <ComboBox Style="{StaticResource GwFilterSupportSlotComboBox}">
                    <ComboBox.GroupStyle>
                        <GroupStyle HeaderTemplate="{StaticResource GwComboBoxGroupHeaderTemplate}" />
                    </ComboBox.GroupStyle>
                </ComboBox>
                <!--<ComboBox Style="{StaticResource GwFilterUnlockSlotComboBox}">
                    <ComboBox.GroupStyle>
                        <GroupStyle HeaderTemplate="{StaticResource GwComboBoxGroupHeaderTemplate}" />
                    </ComboBox.GroupStyle>
                </ComboBox>
                <ComboBox Style="{StaticResource GwFilterBonusSlotComboBox}">
                    <ComboBox.GroupStyle>
                        <GroupStyle HeaderTemplate="{StaticResource GwComboBoxGroupHeaderTemplate}" />
                    </ComboBox.GroupStyle>
                </ComboBox>-->
                <ToggleButton Style="{StaticResource GwFilterHasMemoToggleButton}" />
                <ToggleButton Style="{StaticResource GwFilterHasNoMobileToggleButton}" />
                <ToggleButton Style="{StaticResource GwFilterIsNotPinnedToggleButton}" />
                <ComboBox Style="{StaticResource GwFilterSerialComboBox}" />
            </ToolBar>
        </ToolBarTray>
        <commons:StatusBarView DockPanel.Dock="Bottom" />
        <supports:SupportDataGridView />
    </DockPanel>
</UserControl>
