<UserControl x:Class="Ju.GundamWars.Supports.View.SupportEntryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mahApps="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    xmlns:core="clr-namespace:Ju.GundamWars;assembly=Ju.GundamWars.Core"
    xmlns:supports="clr-namespace:Ju.GundamWars.Supports.View"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance supports:SupportEntryViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    >
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Height="50" Orientation="Horizontal">
            <Button
                Style="{StaticResource GwEntry.CancelButton}"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Command="{Binding DataContext.CancelCommand, RelativeSource={StaticResource GwSupportListRelativeSource}}"
            />
        </StackPanel>
        <Grid />
    </DockPanel>
</UserControl>
