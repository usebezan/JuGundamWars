<UserControl
    x:Class="Ju.GundamWars.Pilots.PilotEntryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ctrl="clr-namespace:Ju.GundamWars.Controls"
    xmlns:mobile="clr-namespace:Ju.GundamWars.Mobiles"
    xmlns:local="clr-namespace:Ju.GundamWars.Pilots"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance local:PilotEntryViewModel}"
    d:DesignHeight="1200"
    d:DesignWidth="1200"
    SnapsToDevicePixels="True"
    >
    <UserControl.Resources>
        <Style x:Key="GwEntryPilotSkillComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource GwEntryComboBox}">
            <Setter Property="DisplayMemberPath" Value="Name" />
            <Setter Property="ItemsSource" Value="{Binding Skills}" />
            <Setter Property="SelectedItem" Value="{Binding Entry.Skill}" />
        </Style>
        <Style x:Key="GwEntryPilotSkillTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource GwEntryFullTextBox}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style x:Key="GwEntryPilotSlotRankComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource GwEntryComboBox}">
            <Setter Property="Width" Value="40" />
            <Setter Property="ItemsSource" Value="{Binding SlotRanks}" />
        </Style>
        <Style x:Key="GwEntryPilotAbilityComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource GwEntryComboBox}">
            <Setter Property="DisplayMemberPath" Value="Name" />
            <Setter Property="ItemsSource" Value="{Binding Abilities}" />
            <Setter Property="materialDesign:TextFieldAssist.HasClearButton" Value="True" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="520" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ctrl:EntryTitleUserControl Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="16" />
        <Grid Grid.Row="1" Grid.Column="0" Margin="16 0 0 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <GroupBox Grid.Row="0" Margin="0 0 0 16" Header="Name">
                <DockPanel>
                    <materialDesign:PackIcon DockPanel.Dock="Left" VerticalAlignment="Center" Margin="8 0 0 8" Kind="{Binding Entry.CategoryIcon}" />
                    <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding Entry.IsPinned}" Content="{materialDesign:PackIcon Kind=Pin}" />
                    <TextBox VerticalAlignment="Center" Style="{StaticResource GwEntryFullTextBox}" Text="{Binding Entry.Name}" />
                </DockPanel>
            </GroupBox>
            <TabControl Grid.Row="1" Margin="0 0 0 16" SelectedIndex="{Binding TabIndex, Mode=OneWay}">
                <TabItem Header="Default">
                    <ScrollViewer Margin="0 16 0 0" VerticalScrollBarVisibility="Visible">
                        <StackPanel>
                            <GroupBox Header="Series">
                                <ComboBox Style="{StaticResource GwEntrySerialComboBox}" />
                            </GroupBox>
                            <GroupBox Header="Skill">
                                <StackPanel>
                                    <ComboBox Style="{StaticResource GwEntryPilotSkillComboBox}">
                                        <ComboBox.GroupStyle>
                                            <GroupStyle HeaderTemplate="{StaticResource GwComboBoxGroupHeaderTemplate}" />
                                        </ComboBox.GroupStyle>
                                    </ComboBox>
                                    <TextBox Style="{StaticResource GwEntryPilotSkillTextBox}" Text="{Binding Entry.SkillText1}" />
                                    <TextBox Style="{StaticResource GwEntryPilotSkillTextBox}" Text="{Binding Entry.SkillText2}" />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Leveling">
                    <ScrollViewer Margin="0 16 0 0" VerticalScrollBarVisibility="Visible">
                        <StackPanel>
                            <GroupBox Header="Grade">
                                <ListBox Style="{StaticResource GwEntryGradeListBox}" />
                            </GroupBox>
                            <GroupBox Header="Level">
                                <TextBox Style="{StaticResource GwEntryLevelTextBox}" />
                            </GroupBox>
                            <GroupBox Header="Basic Status">
                                <local:PilotEntryStatusUserControl DataContext="{Binding Entry.BasicStatus}" />
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Custom">
                    <ScrollViewer Margin="0 16 0 0" VerticalScrollBarVisibility="Visible">
                        <StackPanel>
                            <GroupBox Style="{StaticResource GwGroupBox}" Margin="0 0 16 16">
                                <GroupBox.Header>
                                    <DockPanel>
                                        <Button
                                            DockPanel.Dock="Right"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource GwEntryToolButton}"
                                            Command="{Binding ResetPracticedCommand}"
                                            Content="{materialDesign:PackIcon CircleOutline}"
                                            ToolTip="Reset all Practiced"
                                        />
                                        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8 0 32 0">
                                            <Run Text="{Binding Entry.PracticedStatusTotal, Mode=OneWay}" />
                                            <Run Text="/" />
                                            <Run Text="3000" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource GwGroupBoxHeaderTextBlock}" Text="Practiced Status" />
                                    </DockPanel>
                                </GroupBox.Header>
                                <local:PilotEntryStatusUserControl DataContext="{Binding Entry.PracticedStatus}" />
                            </GroupBox>
                            <GroupBox Header="Abilities">
                                <StackPanel Orientation="Vertical" Grid.IsSharedSizeScope="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" Style="{StaticResource GwEntryPilotSlotRankComboBox}" SelectedValue="{Binding Entry.SlotRank1}" />
                                        <ComboBox Grid.Column="1" Style="{StaticResource GwEntryPilotAbilityComboBox}" SelectedItem="{Binding Entry.Ability1}">
                                            <ComboBox.GroupStyle>
                                                <GroupStyle HeaderTemplate="{StaticResource GwComboBoxGroupHeaderTemplate}" />
                                            </ComboBox.GroupStyle>
                                        </ComboBox>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" Style="{StaticResource GwEntryPilotSlotRankComboBox}" SelectedValue="{Binding Entry.SlotRank2}" />
                                        <ComboBox Grid.Column="1" Style="{StaticResource GwEntryPilotAbilityComboBox}" SelectedItem="{Binding Entry.Ability2}">
                                            <ComboBox.GroupStyle>
                                                <GroupStyle HeaderTemplate="{StaticResource GwComboBoxGroupHeaderTemplate}" />
                                            </ComboBox.GroupStyle>
                                        </ComboBox>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" Style="{StaticResource GwEntryPilotSlotRankComboBox}" SelectedValue="{Binding Entry.SlotRank3}" />
                                        <ComboBox Grid.Column="1" Style="{StaticResource GwEntryPilotAbilityComboBox}" SelectedItem="{Binding Entry.Ability3}">
                                            <ComboBox.GroupStyle>
                                                <GroupStyle HeaderTemplate="{StaticResource GwComboBoxGroupHeaderTemplate}" />
                                            </ComboBox.GroupStyle>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Style="{StaticResource GwGroupBox}" Margin="0 0 16 16">
                                <GroupBox.Header>
                                    <DockPanel>
                                        <Button
                                            DockPanel.Dock="Right"
                                            Margin="8 0 0 0"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource GwEntryToolButton}"
                                            Command="{Binding UncheckAllTagsCommand}"
                                            Content="{materialDesign:PackIcon CircleOutline}"
                                            ToolTip="Uncheck all Tags"
                                        />
                                        <TextBlock Style="{StaticResource GwGroupBoxHeaderTextBlock}" Text="Tags" />
                                    </DockPanel>
                                </GroupBox.Header>
                                <ListBox Style="{StaticResource GwEntryTagListBox}" />
                            </GroupBox>
                            <GroupBox Header="Memo">
                                <TextBox Style="{StaticResource GwEntryMemoTextBox}" />
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
            <ctrl:EntryButtonUserControl Grid.Row="2" Margin="0 0 0 16" />
        </Grid>
        <ScrollViewer Grid.Row="1" Grid.Column="1" Margin="16 0 0 0" VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource GwSummaryBorder}" DataContext="{Binding Entry}">
                <local:PilotSummaryUserControl />
            </Border>
        </ScrollViewer>
        <ScrollViewer Grid.Row="1" Grid.Column="2" Margin="16 0 0 0" VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource GwSummaryBorder}" DataContext="{Binding Entry.Mobile}">
                <mobile:MobileSummaryUserControl />
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
