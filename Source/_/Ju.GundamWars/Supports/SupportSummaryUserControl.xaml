<UserControl x:Class="Ju.GundamWars.Supports.SupportSummaryUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:domain="clr-namespace:Ju.GundamWars.Domain.Supports;assembly=Ju.GundamWars.Core"
    xmlns:const="clr-namespace:Ju.GundamWars.Const;assembly=Ju.GundamWars.Core"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance domain:SupportSubject}"
    SnapsToDevicePixels="True"
    >
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Column="0" Grid.Row="1" Style="{StaticResource GwEntryStatusLabelRightTextBlock}" Text="{Binding Source={x:Static const:GwText.Hp}}" />
        <TextBlock Grid.Column="0" Grid.Row="2" Style="{StaticResource GwEntryStatusLabelRightTextBlock}" Text="{Binding Source={x:Static const:GwText.BeamAttack}}" />
        <TextBlock Grid.Column="0" Grid.Row="3" Style="{StaticResource GwEntryStatusLabelRightTextBlock}" Text="{Binding Source={x:Static const:GwText.PhysicalAttack}}" />
        <TextBlock Grid.Column="0" Grid.Row="4" Style="{StaticResource GwEntryStatusLabelRightTextBlock}" Text="{Binding Source={x:Static const:GwText.BeamDefence}}" />
        <TextBlock Grid.Column="0" Grid.Row="5" Style="{StaticResource GwEntryStatusLabelRightTextBlock}" Text="{Binding Source={x:Static const:GwText.PhysicalDefence}}" />
        <TextBlock Grid.Column="0" Grid.Row="6" Style="{StaticResource GwEntryStatusLabelRightTextBlock}" Text="{Binding Source={x:Static const:GwText.CriticalDamage}}" />
        <TextBlock Grid.Column="0" Grid.Row="7" Style="{StaticResource GwEntryStatusLabelRightTextBlock}" Text="{Binding Source={x:Static const:GwText.Accuracy}}" />
        <TextBlock Grid.Column="0" Grid.Row="8" Style="{StaticResource GwEntryStatusLabelRightTextBlock}" Text="{Binding Source={x:Static const:GwText.Evasion}}" />
        <TextBlock Grid.Column="0" Grid.Row="9" Style="{StaticResource GwEntryStatusLabelRightTextBlock}" Text="{Binding Source={x:Static const:GwText.Mobility}}" />
        <TextBlock Grid.Column="0" Grid.Row="10" Style="{StaticResource GwEntryStatusLabelRightTextBlock}" Text="{Binding Source={x:Static const:GwText.EnRecovery}}" />
        <TextBlock Grid.Column="0" Grid.Row="11" Style="{StaticResource GwEntryStatusLabelRightTextBlock}" Text="{Binding Source={x:Static const:GwText.SuperPower}}" />
        <TextBlock Grid.Column="0" Grid.Row="12" Style="{StaticResource GwEntryStatusLabelRightTextBlock}" Text="{Binding Source={x:Static const:GwText.AcePower}}" />
        <TextBlock Grid.Column="0" Grid.Row="13" Style="{StaticResource GwEntryStatusLabelRightTextBlock}" Text="{Binding Source={x:Static const:GwText.RecoveryPower}}" />

        <TextBlock Grid.Column="1" Grid.Row="0" Style="{StaticResource GwEntryStatusLabelTextBlock}" Text="Actual" />
        <TextBlock Grid.Column="1" Grid.Row="1" Style="{StaticResource GwEntryStatusTextBlock}" DataContext="{Binding ActualStatus.Hp}" />
        <TextBlock Grid.Column="1" Grid.Row="2" Style="{StaticResource GwEntryStatusTextBlock}" DataContext="{Binding ActualStatus.BeamAttack}" />
        <TextBlock Grid.Column="1" Grid.Row="3" Style="{StaticResource GwEntryStatusTextBlock}" DataContext="{Binding ActualStatus.PhysicalAttack}" />
        <TextBlock Grid.Column="1" Grid.Row="4" Style="{StaticResource GwEntryStatusTextBlock}" DataContext="{Binding ActualStatus.BeamDefence}" />
        <TextBlock Grid.Column="1" Grid.Row="5" Style="{StaticResource GwEntryStatusTextBlock}" DataContext="{Binding ActualStatus.PhysicalDefence}" />
        <TextBlock Grid.Column="1" Grid.Row="6" Style="{StaticResource GwEntryStatusTextBlock}" DataContext="{Binding ActualStatus.CriticalDamage}" />
        <TextBlock Grid.Column="1" Grid.Row="7" Style="{StaticResource GwEntryStatusTextBlock}" DataContext="{Binding ActualStatus.Accuracy}" />
        <TextBlock Grid.Column="1" Grid.Row="8" Style="{StaticResource GwEntryStatusTextBlock}" DataContext="{Binding ActualStatus.Evasion}" />
        <TextBlock Grid.Column="1" Grid.Row="9" Style="{StaticResource GwEntryStatusTextBlock}" DataContext="{Binding ActualStatus.Mobility}" />
        <TextBlock Grid.Column="1" Grid.Row="10" Style="{StaticResource GwEntryStatusTextBlock}" DataContext="{Binding ActualStatus.EnRecovery}" />
        <TextBlock Grid.Column="1" Grid.Row="11" Style="{StaticResource GwEntryPerStatusTextBlock}" DataContext="{Binding ActualStatus.SuperPower}" />
        <TextBlock Grid.Column="1" Grid.Row="12" Style="{StaticResource GwEntryPerStatusTextBlock}" DataContext="{Binding ActualStatus.AcePower}" />
        <TextBlock Grid.Column="1" Grid.Row="13" Style="{StaticResource GwEntryPerStatusTextBlock}" DataContext="{Binding ActualStatus.RecoveryPower}" />

        <TextBlock Grid.Column="2" Grid.Row="0" Style="{StaticResource GwEntryStatusLabelTextBlock}" Text="Unlock" />
        <TextBlock Grid.Column="2" Grid.Row="1" Style="{StaticResource GwEntryStatusTextBlock}" DataContext="{Binding UnlockStatus.Hp}" />
        <TextBlock Grid.Column="2" Grid.Row="2" Style="{StaticResource GwEntryStatusTextBlock}" DataContext="{Binding UnlockStatus.BeamAttack}" />
        <TextBlock Grid.Column="2" Grid.Row="3" Style="{StaticResource GwEntryStatusTextBlock}" DataContext="{Binding UnlockStatus.PhysicalAttack}" />
        <TextBlock Grid.Column="2" Grid.Row="4" Style="{StaticResource GwEntryStatusTextBlock}" DataContext="{Binding UnlockStatus.BeamDefence}" />
        <TextBlock Grid.Column="2" Grid.Row="5" Style="{StaticResource GwEntryStatusTextBlock}" DataContext="{Binding UnlockStatus.PhysicalDefence}" />
        <TextBlock Grid.Column="2" Grid.Row="6" Style="{StaticResource GwEntryStatusTextBlock}" DataContext="{Binding UnlockStatus.CriticalDamage}" />
        <TextBlock Grid.Column="2" Grid.Row="7" Style="{StaticResource GwEntryStatusTextBlock}" DataContext="{Binding UnlockStatus.Accuracy}" />
        <TextBlock Grid.Column="2" Grid.Row="8" Style="{StaticResource GwEntryStatusTextBlock}" DataContext="{Binding UnlockStatus.Evasion}" />
        <TextBlock Grid.Column="2" Grid.Row="9" Style="{StaticResource GwEntryStatusTextBlock}" DataContext="{Binding UnlockStatus.Mobility}" />
        <TextBlock Grid.Column="2" Grid.Row="10" Style="{StaticResource GwEntryStatusTextBlock}" DataContext="{Binding UnlockStatus.EnRecovery}" />
        <TextBlock Grid.Column="2" Grid.Row="11" Style="{StaticResource GwEntryPerStatusTextBlock}" DataContext="{Binding UnlockStatus.SuperPower}" />
        <TextBlock Grid.Column="2" Grid.Row="12" Style="{StaticResource GwEntryPerStatusTextBlock}" DataContext="{Binding UnlockStatus.AcePower}" />
        <TextBlock Grid.Column="2" Grid.Row="13" Style="{StaticResource GwEntryPerStatusTextBlock}" DataContext="{Binding UnlockStatus.RecoveryPower}" />

        <TextBlock Grid.Column="3" Grid.Row="0" Style="{StaticResource GwEntryStatusLabelTextBlock}" Text="Bonus" />
        <TextBlock Grid.Column="3" Grid.Row="1" Style="{StaticResource GwEntryStatusTextBlock}" DataContext="{Binding BonusStatus.Hp}" />
        <TextBlock Grid.Column="3" Grid.Row="2" Style="{StaticResource GwEntryStatusTextBlock}" DataContext="{Binding BonusStatus.BeamAttack}" />
        <TextBlock Grid.Column="3" Grid.Row="3" Style="{StaticResource GwEntryStatusTextBlock}" DataContext="{Binding BonusStatus.PhysicalAttack}" />
        <TextBlock Grid.Column="3" Grid.Row="4" Style="{StaticResource GwEntryStatusTextBlock}" DataContext="{Binding BonusStatus.BeamDefence}" />
        <TextBlock Grid.Column="3" Grid.Row="5" Style="{StaticResource GwEntryStatusTextBlock}" DataContext="{Binding BonusStatus.PhysicalDefence}" />
        <TextBlock Grid.Column="3" Grid.Row="6" Style="{StaticResource GwEntryStatusTextBlock}" DataContext="{Binding BonusStatus.CriticalDamage}" />
        <TextBlock Grid.Column="3" Grid.Row="7" Style="{StaticResource GwEntryStatusTextBlock}" DataContext="{Binding BonusStatus.Accuracy}" />
        <TextBlock Grid.Column="3" Grid.Row="8" Style="{StaticResource GwEntryStatusTextBlock}" DataContext="{Binding BonusStatus.Evasion}" />
        <TextBlock Grid.Column="3" Grid.Row="9" Style="{StaticResource GwEntryStatusTextBlock}" DataContext="{Binding BonusStatus.Mobility}" />
        <TextBlock Grid.Column="3" Grid.Row="10" Style="{StaticResource GwEntryStatusTextBlock}" DataContext="{Binding BonusStatus.EnRecovery}" />
        <TextBlock Grid.Column="3" Grid.Row="11" Style="{StaticResource GwEntryPerStatusTextBlock}" DataContext="{Binding BonusStatus.SuperPower}" />
        <TextBlock Grid.Column="3" Grid.Row="12" Style="{StaticResource GwEntryPerStatusTextBlock}" DataContext="{Binding BonusStatus.AcePower}" />
        <TextBlock Grid.Column="3" Grid.Row="13" Style="{StaticResource GwEntryPerStatusTextBlock}" DataContext="{Binding BonusStatus.RecoveryPower}" />

        <TextBlock Grid.Column="4" Grid.Row="0" Style="{StaticResource GwEntryStatusLabelTextBlock}" Text="Normal" />
        <TextBlock Grid.Column="4" Grid.Row="1" Style="{StaticResource GwEntryStatusTextBlock}" DataContext="{Binding NormalStatus.Hp}" />
        <TextBlock Grid.Column="4" Grid.Row="2" Style="{StaticResource GwEntryStatusTextBlock}" DataContext="{Binding NormalStatus.BeamAttack}" />
        <TextBlock Grid.Column="4" Grid.Row="3" Style="{StaticResource GwEntryStatusTextBlock}" DataContext="{Binding NormalStatus.PhysicalAttack}" />
        <TextBlock Grid.Column="4" Grid.Row="4" Style="{StaticResource GwEntryStatusTextBlock}" DataContext="{Binding NormalStatus.BeamDefence}" />
        <TextBlock Grid.Column="4" Grid.Row="5" Style="{StaticResource GwEntryStatusTextBlock}" DataContext="{Binding NormalStatus.PhysicalDefence}" />
        <TextBlock Grid.Column="4" Grid.Row="6" Style="{StaticResource GwEntryStatusTextBlock}" DataContext="{Binding NormalStatus.CriticalDamage}" />
        <TextBlock Grid.Column="4" Grid.Row="7" Style="{StaticResource GwEntryStatusTextBlock}" DataContext="{Binding NormalStatus.Accuracy}" />
        <TextBlock Grid.Column="4" Grid.Row="8" Style="{StaticResource GwEntryStatusTextBlock}" DataContext="{Binding NormalStatus.Evasion}" />
        <TextBlock Grid.Column="4" Grid.Row="9" Style="{StaticResource GwEntryStatusTextBlock}" DataContext="{Binding NormalStatus.Mobility}" />
        <TextBlock Grid.Column="4" Grid.Row="10" Style="{StaticResource GwEntryStatusTextBlock}" DataContext="{Binding NormalStatus.EnRecovery}" />
        <TextBlock Grid.Column="4" Grid.Row="11" Style="{StaticResource GwEntryPerStatusTextBlock}" DataContext="{Binding NormalStatus.SuperPower}" />
        <TextBlock Grid.Column="4" Grid.Row="12" Style="{StaticResource GwEntryPerStatusTextBlock}" DataContext="{Binding NormalStatus.AcePower}" />
        <TextBlock Grid.Column="4" Grid.Row="13" Style="{StaticResource GwEntryPerStatusTextBlock}" DataContext="{Binding NormalStatus.RecoveryPower}" />
    </Grid>
</UserControl>
